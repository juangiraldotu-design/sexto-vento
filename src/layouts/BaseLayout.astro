---
import '../styles/global.css';
import { restaurantConfig } from '../config/restaurant.config';
import IntroCurtain from '../components/IntroCurtain.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${restaurantConfig.name} • Rooftop & Experiencia Gastronómica en Roldanillo`,
  description = restaurantConfig.description,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.png`} />
    <meta name="generator" content={Astro.generator} />

    <!-- Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0704" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <!-- Open Graph -->
    <meta property="og:type" content="restaurant" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/hero-rooftop.jpg" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={restaurantConfig.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/assets/hero-rooftop.jpg" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Restaurant",
      "name": restaurantConfig.name,
      "description": restaurantConfig.description,
      "telephone": restaurantConfig.whatsappDisplay,
      "url": "https://instagram.com/sexto_vento",
      "hasMenu": restaurantConfig.menuUrl,
      "servesCuisine": "Gastronomía contemporánea, Brunch, Parrilla, Coctelería de autor",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": restaurantConfig.location.address,
        "addressLocality": restaurantConfig.location.city,
        "addressRegion": restaurantConfig.location.department,
        "addressCountry": "CO"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": restaurantConfig.location.coordinates.lat,
        "longitude": restaurantConfig.location.coordinates.lng
      }
    })} />
  </head>
  <body class="bg-[#0B0704] text-[#FDF8F3] min-h-screen relative antialiased selection:bg-amber-500/30 selection:text-amber-200 max-w-full">

    <!-- Cinematic Split Curtain Intro -->
    <IntroCurtain />

    <div class="relative z-10 max-w-full">
      <slot />
    </div>

    <!-- Optimized Floating Dock Controller -->
    <script is:inline>
      const dock = document.getElementById('floating-dock');
      if (dock) {
        let prevY = window.scrollY;
        let isVisible = false;
        let ticking = false;

        function updateDock() {
          const y = window.scrollY;
          // Show dock only when scrolled past Hero (300px) and scrolling up or stopped
          const shouldShow = y > 300 && y <= prevY;
          if (shouldShow !== isVisible) {
            isVisible = shouldShow;
            if (isVisible) {
              dock.classList.remove('translate-y-[120%]', 'opacity-0');
              dock.classList.add('translate-y-0', 'opacity-100');
            } else {
              dock.classList.remove('translate-y-0', 'opacity-100');
              dock.classList.add('translate-y-[120%]', 'opacity-0');
            }
          }
          prevY = y;
          ticking = false;
        }

        window.addEventListener('scroll', () => {
          if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(updateDock);
          }
        }, { passive: true });
      }
    </script>
  </body>
</html>
