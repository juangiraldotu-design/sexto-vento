---
import { restaurantConfig } from '../config/restaurant.config';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const dishes = [
  {
    id: 'croissant',
    category: 'brunch',
    imageWebp: `${baseUrl}/images/dishes/croissant-pistacho.webp`,
    imageJpg: `${baseUrl}/images/dishes/croissant-pistacho.jpg`,
    badge: 'Desayuno & Brunch',
    tag: 'Especialidad',
    title: 'Croissant de Pistacho & Café 3D',
    desc: 'Hojaldre artesanal de mantequilla con crema de pistacho tostado y latte art tridimensional de autor.',
  },
  {
    id: 'burrata',
    category: 'entradas',
    imageWebp: `${baseUrl}/images/dishes/burrata-prosciutto.webp`,
    imageJpg: `${baseUrl}/images/dishes/burrata-prosciutto.jpg`,
    badge: 'Entrada Signature',
    tag: 'Para Iniciar',
    title: 'Bruschetta di Burrata & Prosciutto',
    desc: 'Masa madre tostada al horno con pesto fresco, burrata cremosa y rosas de prosciutto di Parma.',
  },
  {
    id: 'pasta',
    category: 'fuertes',
    imageWebp: `${baseUrl}/images/dishes/pasta-fettuccine.webp`,
    imageJpg: `${baseUrl}/images/dishes/pasta-fettuccine.jpg`,
    badge: 'Almuerzo & Cena',
    tag: 'Plato Fuerte',
    title: 'Fettuccine Alfredo & Pollo a la Brasa',
    desc: 'Pasta fresca en suave crema de quesos madurados, pechuga a la brasa y finas tostadas de la casa.',
  },
  {
    id: 'sandwich',
    category: 'fuertes',
    imageWebp: `${baseUrl}/images/dishes/sandwich-brisket.webp`,
    imageJpg: `${baseUrl}/images/dishes/sandwich-brisket.jpg`,
    badge: 'Cocción Lenta',
    tag: 'Favorito Rooftop',
    title: 'Sándwich de Brisket en Masa Madre',
    desc: 'Carne desmechada en cocción lenta de 12 horas, queso fundido y chips artesanales crocantes.',
  },
  {
    id: 'coffee',
    category: 'cocteles',
    imageWebp: `${baseUrl}/images/dishes/caramel-coffee-cocktail.webp`,
    imageJpg: `${baseUrl}/images/dishes/caramel-coffee-cocktail.jpg`,
    badge: 'Coctelería & Café',
    tag: 'Bebida de Autor',
    title: 'Caramel Cold Brew & Cream',
    desc: 'Concentrado de café especial de altura sobre granos seleccionados con caramelo y espuma de leche sedosa.',
  },
  {
    id: 'tenders',
    category: 'entradas',
    imageWebp: `${baseUrl}/images/dishes/crispy-chicken.webp`,
    imageJpg: `${baseUrl}/images/dishes/crispy-chicken.jpg`,
    badge: 'Para Compartir',
    tag: 'Picadas',
    title: 'Tenders Crocantes & Chips de Plátano',
    desc: 'Supremas apanadas en panko con plátano fino verde crujiente, pétalos comestibles y dip especial.',
  }
];
---

<section id="platos" class="relative mx-auto w-full max-w-6xl px-4 py-14 sm:px-6 lg:py-24">
  <!-- Section Header -->
  <div class="mb-8 flex w-full min-w-0 max-w-full flex-col gap-6 border-b border-amber-100/25 pb-7 text-left md:mb-10 lg:mb-12 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-2xl min-w-0">
      <div class="editorial-kicker mb-3 inline-flex items-center gap-2 lg:mb-4">
        <span>Selección Especial</span>
      </div>
      <h2 class="mb-3 break-words text-4xl font-black leading-[0.92] tracking-[-0.055em] text-white sm:text-5xl lg:text-7xl">
        Nuestros Recomendados
      </h2>
      <p class="text-xs sm:text-sm md:text-base text-slate-300/85 font-normal leading-relaxed">
        Una selección de nuestras especialidades recomendadas en el piso 4: brunch, cocina italiana a la carta, platos fuertes y coctelería de autor. Carta completa disponible en el menú digital.
      </p>
    </div>
    
    <!-- Category Filter Pills (Fluid Tab Switcher) -->
    <div class="no-scrollbar flex w-full min-w-0 max-w-full items-center justify-start gap-1 overflow-x-auto pb-2 lg:w-auto lg:justify-end lg:pb-0" id="dish-filters">
      <button 
        class="filter-btn active shrink-0 bg-white px-3.5 py-2 text-[10px] font-black uppercase tracking-[0.11em] text-black shadow-md transition-all duration-200 sm:px-5"
        data-filter="all"
      >
        Todo
      </button>
      <button 
        class="filter-btn liquid-pill shrink-0 px-3.5 py-2 text-[10px] font-bold uppercase tracking-[0.11em] text-white/80 transition-all duration-200 hover:text-white sm:px-5"
        data-filter="brunch"
      >
        Brunch
      </button>
      <button 
        class="filter-btn liquid-pill shrink-0 px-3.5 py-2 text-[10px] font-bold uppercase tracking-[0.11em] text-white/80 transition-all duration-200 hover:text-white sm:px-5"
        data-filter="fuertes"
      >
        Fuertes
      </button>
      <button 
        class="filter-btn liquid-pill shrink-0 px-3.5 py-2 text-[10px] font-bold uppercase tracking-[0.11em] text-white/80 transition-all duration-200 hover:text-white sm:px-5"
        data-filter="entradas"
      >
        Entradas
      </button>
      <button 
        class="filter-btn liquid-pill shrink-0 px-3.5 py-2 text-[10px] font-bold uppercase tracking-[0.11em] text-white/80 transition-all duration-200 hover:text-white sm:px-5"
        data-filter="cocteles"
      >
        Coctelería
      </button>
    </div>
  </div>

  <!-- Cards Grid with Staggered Cascading Animation -->
  <div class="grid w-full max-w-full grid-cols-1 gap-px overflow-hidden border border-amber-100/20 bg-amber-100/20 sm:grid-cols-2 lg:grid-cols-3" id="dishes-grid">
    {dishes.map((dish) => (
      <article 
        class="dish-card editorial-dish-card group flex w-full min-w-0 flex-col justify-between bg-[#110a06] p-0"
        data-category={dish.category}
      >
        <!-- Photo Container with Squircle Corners -->
        <div class="relative mb-0 aspect-[4/3] w-full overflow-hidden bg-[#1A0F09]">
          <picture>
            <source srcset={dish.imageWebp} type="image/webp" />
            <img 
              src={dish.imageJpg} 
              alt={dish.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              width="600"
              height="450"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <!-- Badge Inside Photo -->
          <div class="absolute left-2.5 top-2.5 border border-white/20 bg-black/80 px-3 py-1 text-[9px] font-bold uppercase tracking-[0.12em] text-white shadow-lg">
            {dish.badge}
          </div>
          <div class="absolute bottom-0 inset-x-0 h-14 bg-gradient-to-t from-[#0B0704]/85 to-transparent"></div>
        </div>

        <!-- Typography & Content -->
        <div class="flex flex-1 flex-col justify-between p-4 sm:p-5">
          <div>
            <div class="text-[10px] font-extrabold tracking-wider uppercase text-amber-300 mb-1">
              {dish.tag}
            </div>
            <h3 class="text-sm sm:text-base font-bold text-white tracking-tight leading-snug group-hover:text-amber-200 transition-colors mb-1.5">
              {dish.title}
            </h3>
            <p class="mb-5 line-clamp-2 text-xs leading-relaxed text-slate-300/80">
              {dish.desc}
            </p>
          </div>

          <!-- Apple Signature Action Pill: White Pill + Black Arrow Circle -->
          <a 
            href={restaurantConfig.menuUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="dish-menu-link group/btn inline-flex w-full items-center justify-between border-t border-amber-100/20 pt-3 text-[10px] font-black uppercase tracking-[0.12em] text-amber-100 transition-colors hover:text-amber-300"
          >
            <span class="tracking-tight">Ver en Menú</span>
            <span class="grid h-6 w-6 place-items-center border border-current text-[10px] font-bold transition-transform duration-200 group-hover/btn:rotate-45">
              ↗
            </span>
          </a>
        </div>

      </article>
    ))}
  </div>

  <!-- Full Digital Menu Callout Banner -->
  <div class="editorial-section relative mt-8 overflow-hidden border-y border-amber-400/30 p-6 text-center md:mt-12 md:p-10 lg:mt-16">
    <div class="relative z-10">
      <h3 class="text-base sm:text-lg md:text-2xl font-extrabold text-white mb-2 md:mb-3 tracking-tight">
        ¿Deseas consultar la carta completa con precios?
      </h3>
      <p class="text-xs text-slate-300/85 mb-5 max-w-sm mx-auto leading-relaxed">
        Explora todos los desayunos, platos fuertes, cócteles de autor y postres actualizados en nuestra plataforma Unglo.
      </p>
      <a 
        href={restaurantConfig.menuUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="apple-cta-primary inline-flex items-center justify-between gap-4 pl-6 pr-2 py-2.5 text-xs sm:text-sm font-bold shadow-xl btn-press group"
      >
        <span>Abrir Menú Digital en Unglo</span>
        <span class="w-7 h-7 rounded-full bg-black text-white flex items-center justify-center text-xs font-bold group-hover:rotate-45 transition-transform duration-200">
          ↗
        </span>
      </a>
    </div>
  </div>
</section>

<!-- Filter Interactivity Script with Fluid Transitions -->
<script is:inline>
  const filterBtns = document.querySelectorAll('#dish-filters .filter-btn');
  const dishCards = document.querySelectorAll('#dishes-grid .dish-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-white', 'text-black', 'shadow-md', 'active');
        b.classList.add('liquid-pill', 'text-white/80');
      });

      btn.classList.add('bg-white', 'text-black', 'shadow-md', 'active');
      btn.classList.remove('liquid-pill', 'text-white/80');

      const filter = btn.getAttribute('data-filter');

      dishCards.forEach(card => {
        const category = card.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          card.style.display = 'flex';
          window.requestAnimationFrame(() => {
            card.style.opacity = '1';
            card.style.transform = 'translate3d(0, 0, 0)';
          });
        } else {
          card.style.opacity = '0';
          card.style.transform = 'translate3d(0, 10px, 0)';
          setTimeout(() => {
            if (card.style.opacity === '0') card.style.display = 'none';
          }, 200);
        }
      });
    });
  });
</script>
