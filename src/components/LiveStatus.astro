---
import { restaurantConfig } from '../config/restaurant.config';
---

<section class="reveal-on-scroll mx-auto my-6 w-full max-w-6xl px-4 sm:px-6 lg:my-12">
  <div class="editorial-section relative overflow-hidden border-y border-amber-100/25 p-5 sm:p-7 lg:p-9">
    <!-- Ambient Mini Glow (Zero Blur Filter) -->
    <div class="absolute -right-8 -bottom-8 w-28 h-28 lg:w-48 lg:h-48 rounded-full bg-[radial-gradient(circle,rgba(245,158,11,0.20)_0%,transparent_70%)] pointer-events-none"></div>

    <div class="relative flex items-start justify-between gap-4 mb-5 lg:mb-7">
      <div>
        <div class="mb-2 inline-flex items-center gap-2 border border-amber-100/20 bg-black/20 px-3.5 py-1 text-[10px] font-bold uppercase tracking-[0.13em] lg:mb-3" id="live-badge">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_8px_rgba(52,211,153,0.8)]" id="live-dot"></span>
          <span id="live-text" class="text-emerald-300">Consultando estado...</span>
        </div>
        <h2 class="text-xl font-black tracking-[-0.035em] text-white sm:text-2xl lg:text-4xl">
          Horarios de Atención • Rooftop
        </h2>
      </div>
      <span class="shrink-0 border-l border-amber-100/25 pl-3 text-[10px] font-bold uppercase tracking-[0.16em] text-amber-200/70">
        Jue a Dom
      </span>
    </div>

    <!-- Apple-style Schedule Cards -->
    <div class="relative grid grid-cols-1 border-y border-amber-100/20 text-xs sm:grid-cols-2 lg:text-sm">
      <div class="flex items-center justify-between gap-3 px-1 py-4 sm:border-r sm:border-amber-100/20 sm:px-4">
        <span class="font-medium text-slate-300">Jueves</span>
        <span class="text-amber-300 font-bold">8:00 AM – 11:00 PM</span>
      </div>
      <div class="flex items-center justify-between gap-3 border-t border-amber-100/20 px-1 py-4 sm:border-t-0 sm:px-4">
        <span class="font-medium text-slate-300">Viernes a Domingo</span>
        <span class="text-amber-300 font-bold">8:00 AM – 1:00 AM</span>
      </div>
    </div>

    <div class="relative mt-4 flex items-center justify-between text-[11px] text-white/50 lg:mt-5 lg:text-xs">
      <span>Lun a Mié: Eventos bajo reserva</span>
      <a 
        href={restaurantConfig.whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-amber-400 hover:text-amber-300 font-semibold inline-flex items-center gap-1 transition-colors"
      >
        <span>Consultar fecha</span>
        <span class="text-xs lg:text-sm">↗</span>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  function updateLiveStatus() {
    const now = new Date();
    const bogotaTime = new Date(now.toLocaleString("en-US", { timeZone: "America/Bogota" }));
    const day = bogotaTime.getDay();
    const hours = bogotaTime.getHours();
    const minutes = bogotaTime.getMinutes();
    const currentMinutes = hours * 60 + minutes;

    const dot = document.getElementById('live-dot');
    const text = document.getElementById('live-text');

    if (!dot || !text) return;

    let isOpen = false;
    let closingTime = "";

    // Thursday: 8:00 AM–11:00 PM.
    if (day === 4 && currentMinutes >= 480 && currentMinutes < 1380) {
      isOpen = true;
      closingTime = "11:00 PM";
    }

    // Friday through Sunday daytime service: 8:00 AM–midnight.
    if ((day === 5 || day === 6 || day === 0) && currentMinutes >= 480) {
      isOpen = true;
      closingTime = "1:00 AM";
    }

    // After-midnight service belongs to the previous day: Sat, Sun and Mon until 1:00 AM.
    if ((day === 6 || day === 0 || day === 1) && currentMinutes < 60) {
      isOpen = true;
      closingTime = "1:00 AM";
    }

    if (isOpen) {
      dot.className = "w-2 h-2 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_8px_rgba(52,211,153,0.8)]";
      text.className = "text-emerald-300 font-semibold";
      text.textContent = `Abierto ahora • Hasta las ${closingTime}`;
    } else {
      dot.className = "w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.6)]";
      text.className = "text-amber-300 font-semibold";
      if ((day === 1 && currentMinutes >= 60) || day === 2 || day === 3) {
        text.textContent = "Cerrado hoy • Abrimos el jueves a las 8:00 AM";
      } else {
        text.textContent = "Cerrado en este momento • Abrimos a las 8:00 AM";
      }
    }
  }

  updateLiveStatus();
  window.setInterval(updateLiveStatus, 60_000);
</script>
