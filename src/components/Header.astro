---
import Monogram from './Monogram.astro';
import { restaurantConfig } from '../config/restaurant.config';
---

<header class="site-header fixed top-0 inset-x-0 z-40 safe-top pt-2 sm:pt-3 transition-all duration-300 max-w-full">
  <div class="site-container header-glass flex items-center justify-between px-3 sm:px-5 py-1.5 sm:py-2 rounded-full">

    <!-- Brand: Vector Monogram + Typography -->
    <a href="#hero" class="flex items-center gap-2 sm:gap-2.5 group shrink-0 min-w-0">
      <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full liquid-pill flex items-center justify-center p-1.5 text-amber-400 group-hover:scale-105 transition-transform duration-200 shrink-0">
        <Monogram class="w-full h-full text-amber-400 group-hover:text-amber-200 transition-colors" />
      </div>
      <div class="flex flex-col leading-tight min-w-0">
        <span class="text-xs sm:text-sm font-extrabold tracking-tight text-white group-hover:text-amber-200 transition-colors truncate">
          {restaurantConfig.shortName}
        </span>
        <span class="text-[9px] font-semibold tracking-wider uppercase text-amber-200/50 -mt-0.5 truncate">
          Rooftop • Piso 4
        </span>
      </div>
    </a>

    <!-- Right Actions: Instagram Link + Apple Signature Reservar Pill -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <a
        href={restaurantConfig.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram Sexto Vento"
        class="w-7 h-7 sm:w-auto sm:h-auto sm:px-3 sm:py-1.5 rounded-full flex items-center justify-center text-xs font-medium text-white/70 hover:text-white transition-colors bg-white/5 sm:bg-transparent"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        <span class="hidden sm:inline ml-1.5">Instagram</span>
      </a>

      <!-- Apple Signature Reservar Pill Button with Arrow Circle -->
      <a
        href={restaurantConfig.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="apple-cta-primary inline-flex items-center gap-1.5 pl-3 pr-1 py-1 text-xs font-bold btn-press shadow-md"
      >
        <span>Reservar</span>
        <span class="w-5 h-5 rounded-full bg-black text-white flex items-center justify-center text-[10px] font-bold">
          ↗
        </span>
      </a>
    </div>

  </div>
</header>
