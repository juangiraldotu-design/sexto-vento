---
import Logo from './Logo.astro';
import { restaurantConfig } from '../config/restaurant.config';
---

<header class="fixed inset-x-0 top-0 z-40 px-3 pt-2 transition-all duration-300 sm:px-6 sm:pt-3 safe-top">
  <nav aria-label="Navegación principal" class="editorial-nav mx-auto flex max-w-6xl items-center justify-between px-3 py-2 sm:px-4">
    <a href="#hero" aria-label="Sexto Vento — inicio" class="group flex min-w-0 items-center gap-3">
      <Logo class="h-auto w-[4.3rem] shrink-0 text-white transition-colors duration-200 group-hover:text-amber-200 sm:w-20" />
      <span class="hidden border-l border-amber-100/25 pl-3 text-[9px] font-bold uppercase leading-tight tracking-[0.18em] text-amber-100/55 md:block">
        Rooftop<br />Piso 4
      </span>
    </a>

    <div class="flex shrink-0 items-center gap-1.5 sm:gap-3">
      <a
        href={restaurantConfig.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram Sexto Vento"
        class="inline-flex h-9 items-center gap-2 px-2 text-[10px] font-bold uppercase tracking-[0.14em] text-white/70 transition-colors hover:text-amber-200 sm:px-3"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        <span class="hidden sm:inline">Instagram</span>
      </a>

      <a
        href={restaurantConfig.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-reserve inline-flex h-9 items-center gap-3 px-4 text-[10px] font-black uppercase tracking-[0.14em] sm:px-5"
      >
        Reservar <span aria-hidden="true">↗</span>
      </a>
    </div>
  </nav>
</header>
