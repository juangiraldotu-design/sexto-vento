---
import { restaurantConfig } from '../config/restaurant.config';
---

<section class="max-w-xl md:max-w-3xl lg:max-w-5xl mx-auto px-4 sm:px-6 py-4 lg:py-8 reveal-on-scroll">
  <div class="liquid-card rounded-[28px] p-6 sm:p-7 lg:p-10 border border-white/12 relative overflow-hidden">
    <!-- Ambient Sunset Glow (Zero Blur Filter) -->
    <div class="absolute -right-12 top-0 w-44 h-44 lg:w-72 lg:h-72 rounded-full bg-[radial-gradient(circle,rgba(234,88,12,0.22)_0%,transparent_70%)] pointer-events-none"></div>

    <div class="relative z-10 lg:grid lg:grid-cols-2 lg:gap-12 lg:items-center">
      <div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1 lg:py-1.5 rounded-full liquid-pill text-xs lg:text-sm font-semibold text-amber-300 border border-amber-500/25 mb-3 lg:mb-4">
          <span>Terraza & Atmósfera</span>
        </div>

        <h2 class="text-xl sm:text-2xl lg:text-4xl font-extrabold text-white tracking-tight mb-2.5 lg:mb-4">
          El Mirador Gastronómico de Roldanillo
        </h2>

        <p class="text-xs sm:text-sm lg:text-base text-slate-300/85 leading-relaxed mb-6 lg:mb-0">
          En el 4to piso del <strong>Hotel Casa Volga</strong>, Sexto Vento domina la plaza principal con una vista privilegiada a la cordillera. Brisa del atardecer, coctelería de autor, música selecta y cocina artesanal en el punto más alto del pueblo mágico.
        </p>
      </div>

      <!-- Apple Spec Stats Grid -->
      <div class="grid grid-cols-3 gap-2.5 lg:gap-4 text-center">
        <div class="p-3.5 rounded-[20px] bg-white/[0.04] border border-amber-500/15 hover:bg-white/[0.07] transition-colors">
          <span class="block text-lg sm:text-xl font-extrabold text-amber-300 tracking-tight">4to</span>
          <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Piso Mirador</span>
        </div>
        <div class="p-3.5 rounded-[20px] bg-white/[0.04] border border-amber-500/15 hover:bg-white/[0.07] transition-colors">
          <span class="block text-lg sm:text-xl font-extrabold text-orange-400 tracking-tight">360°</span>
          <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Vista</span>
        </div>
        <div class="p-3.5 rounded-[20px] bg-white/[0.04] border border-amber-500/15 hover:bg-white/[0.07] transition-colors">
          <span class="block text-lg sm:text-xl font-extrabold text-amber-400 tracking-tight">Jue-Dom</span>
          <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Servicio</span>
        </div>
      </div>
    </div>
  </div>
</section>
