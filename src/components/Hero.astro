---
import Logo from './Logo.astro';
import { restaurantConfig } from '../config/restaurant.config';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="hero" class="hero-editorial relative isolate flex min-h-[100svh] items-end overflow-hidden px-4 pb-8 pt-28 sm:px-6 sm:pb-12 sm:pt-32">
  <div class="absolute inset-0 -z-30">
    <picture>
      <source srcset={`${baseUrl}/images/hero/hero-mobile.webp`} media="(max-width: 640px)" type="image/webp" />
      <source srcset={`${baseUrl}/images/hero/hero-mobile.jpg`} media="(max-width: 640px)" type="image/jpeg" />
      <source srcset={`${baseUrl}/images/hero/hero-desktop.webp`} type="image/webp" />
      <img
        src={`${baseUrl}/images/hero/hero-desktop.jpg`}
        alt="Terraza Rooftop de Sexto Vento en Hotel Casa Volga, Roldanillo"
        class="hero-photo h-full w-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>

  <div class="hero-atmosphere absolute inset-0 -z-20"></div>
  <div class="editorial-grid absolute inset-0 -z-10 opacity-60"></div>

  <div class="hero-stage relative mx-auto flex w-full max-w-6xl flex-col justify-between">
    <div class="hero-brand mx-auto flex w-full max-w-2xl flex-col items-center text-center">
      <p class="mb-4 flex items-center gap-3 text-[10px] font-bold uppercase tracking-[0.26em] text-amber-100/80 sm:text-xs">
        <span class="h-px w-8 bg-amber-400/70"></span>
        Hotel Casa Volga · Roldanillo
        <span class="h-px w-8 bg-amber-400/70"></span>
      </p>

      <a href="#hero" aria-label="Sexto Vento — inicio" class="hero-logo block w-[min(76vw,29rem)] text-white">
        <Logo class="h-auto w-full text-white" />
      </a>
    </div>

    <div class="hero-floor-lockup my-5 flex select-none items-end justify-center sm:my-8" aria-label="Piso 4">
      <span class="hero-floor-word">PISO</span>
      <strong class="hero-floor-number">4</strong>
    </div>

    <div class="hero-bottom-grid border-y border-amber-100/25 bg-[#0b0704]/55 backdrop-blur-md">
      <div class="hero-copy px-4 py-5 sm:px-6 sm:py-7 lg:px-8">
        <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.24em] text-amber-300 sm:text-xs">Roldanillo desde arriba</p>
        <h1 class="max-w-2xl text-balance text-2xl font-black leading-[0.98] tracking-[-0.04em] text-white sm:text-4xl lg:text-5xl">
          Sabor, música, vista panorámica &amp; experiencias memorables
        </h1>
        <p class="mt-3 max-w-2xl text-pretty text-xs leading-relaxed text-stone-200/75 sm:text-sm">
          {restaurantConfig.description}
        </p>
      </div>

      <div class="hero-actions grid border-t border-amber-100/20 sm:grid-cols-2 lg:border-l lg:border-t-0">
        <a
          href={restaurantConfig.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-cta editorial-cta--primary group"
        >
          <span>
            <small>Tu mesa en el rooftop</small>
            Reservar
          </span>
          <span class="editorial-cta__arrow" aria-hidden="true">↗</span>
        </a>

        <a
          href={restaurantConfig.menuUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-cta group border-t border-amber-100/20 sm:border-l sm:border-t-0"
        >
          <span>
            <small>Conoce la propuesta</small>
            Ver menú
          </span>
          <span class="editorial-cta__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
