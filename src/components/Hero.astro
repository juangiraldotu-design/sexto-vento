---
import Logo from './Logo.astro';
import { restaurantConfig } from '../config/restaurant.config';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="hero" class="relative min-h-[85vh] sm:min-h-screen flex flex-col justify-center pt-20 pb-8 sm:pt-28 sm:pb-16 px-4 sm:px-6 max-w-full">
  <!-- Cinematic Rooftop Drone Background -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <picture>
      <source srcset={`${baseUrl}/images/hero/hero-mobile.webp`} media="(max-width: 640px)" type="image/webp" />
      <source srcset={`${baseUrl}/images/hero/hero-mobile.jpg`} media="(max-width: 640px)" type="image/jpeg" />
      <source srcset={`${baseUrl}/images/hero/hero-desktop.webp`} type="image/webp" />
      <img 
        src={`${baseUrl}/images/hero/hero-desktop.jpg`} 
        alt="Terraza Rooftop de Sexto Vento en Hotel Casa Volga, Roldanillo" 
        class="w-full h-full object-cover object-center brightness-[0.82]"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <!-- Multi-Layer Vignette Gradients (Seamless blend into warm espresso) -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#0B0704] via-[#0B0704]/75 to-[#0B0704]/30"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#0B0704]/80 via-transparent to-[#0B0704]"></div>
  </div>

  <!-- Hero Content Container -->
  <div class="relative z-10 max-w-xl md:max-w-3xl lg:max-w-5xl mx-auto w-full flex flex-col items-center text-center">
    
    <!-- Floating Eyebrow Pill -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 sm:px-5 sm:py-2 rounded-full liquid-pill text-[11px] sm:text-xs font-semibold text-white/90 mb-3 sm:mb-5 border border-white/15 shadow-lg">
      <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
      <span class="tracking-wide font-medium">Rooftop 4to Piso • Hotel Casa Volga</span>
    </div>

    <!-- Official Pure Vector SVG Logo -->
    <div class="w-40 sm:w-56 md:w-72 lg:w-80 mb-3 sm:mb-5 flex items-center justify-center group">
      <Logo class="w-full h-auto text-white group-hover:text-amber-200 transition-colors duration-300" />
    </div>

    <!-- Main Headline with Modern Apple Contrast -->
    <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white mb-2.5 sm:mb-4 px-2 text-balance leading-tight max-w-lg sm:max-w-2xl">
      Sabor, música, vista panorámica & <span class="bg-gradient-to-r from-amber-200 via-amber-400 to-orange-400 bg-clip-text text-transparent">experiencias memorables</span>
    </h1>

    <p class="text-xs sm:text-sm md:text-base text-slate-300/90 font-normal max-w-sm sm:max-w-md md:max-w-xl mx-auto mb-6 sm:mb-9 px-2 text-balance leading-relaxed">
      {restaurantConfig.description}
    </p>

    <!-- Apple Signature Action Buttons (High-contrast white pill + liquid glass) -->
    <div class="w-full max-w-[320px] sm:max-w-none flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-2.5 sm:gap-4 mb-2 sm:mb-4">
      
      <!-- Primary Action: White Pill CTA with Black Arrow Circle -->
      <a 
        href={restaurantConfig.menuUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="apple-cta-primary w-full sm:w-auto inline-flex items-center justify-between gap-3 pl-5 pr-1.5 py-2 sm:pl-6 sm:pr-2 sm:py-2.5 text-xs sm:text-base font-bold shadow-xl btn-press group"
      >
        <span class="tracking-tight">Ver Menú Digital</span>
        <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-black text-white flex items-center justify-center text-xs font-bold group-hover:rotate-45 transition-transform duration-300 shrink-0">
          ↗
        </span>
      </a>

      <!-- Secondary Action: Liquid Glass Pill CTA with WhatsApp status -->
      <a 
        href={restaurantConfig.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="apple-cta-glass w-full sm:w-auto inline-flex items-center justify-between gap-3 pl-5 pr-2 py-2 sm:pl-6 sm:pr-2.5 sm:py-2.5 text-xs sm:text-base font-semibold btn-press group"
      >
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Reservar Mesa</span>
        </span>
        <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-emerald-500/20 text-emerald-300 flex items-center justify-center text-xs font-bold group-hover:scale-110 transition-transform shrink-0">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.044c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/>
          </svg>
        </span>
      </a>

    </div>

  </div>
</section>
