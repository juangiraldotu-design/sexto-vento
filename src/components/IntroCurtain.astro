---
import Logo from './Logo.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- ════════ ULTRA-REALISTIC ELEVATOR ASCENT & SPLIT DOORS INTRO ════════ -->
<div 
  id="intro-curtain" 
  class="fixed inset-0 z-[100] pointer-events-auto overflow-hidden max-w-full select-none cursor-pointer"
  aria-hidden="true"
>
  <!-- ════════ LEFT ELEVATOR DOOR ════════ -->
  <div 
    id="curtain-left" 
    class="absolute top-0 left-0 w-1/2 h-full overflow-hidden"
    style="transition: transform 1350ms cubic-bezier(0.2, 1, 0.3, 1), opacity 450ms ease-out 850ms;"
  >
    <!-- Background realistic grey elevator door texture -->
    <img 
      src={`${baseUrl}/images/user-door-left-extended.webp`} 
      alt="Puerta izquierda de ascensor metálico"
      class="absolute inset-0 w-full h-full object-cover object-right pointer-events-none brightness-[0.98]"
      loading="eager"
      decoding="async"
    />

    <!-- 200% width container aligned at left: 0 so its center is exactly at the seam -->
    <div class="absolute top-0 left-0 w-[200%] h-full flex flex-col items-center justify-center pointer-events-none">
      <div class="w-48 sm:w-64 md:w-80 lg:w-96 text-white filter drop-shadow-[0_4px_25px_rgba(0,0,0,0.95)] drop-shadow-[0_0_35px_rgba(255,255,255,0.25)]">
        <Logo class="w-full h-auto text-white" />
      </div>

      <!-- Subtle skip text -->
      <div class="mt-8 sm:mt-12 text-[10px] sm:text-xs font-semibold tracking-widest text-slate-300/80 uppercase drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
        Toca para abrir
      </div>
    </div>
  </div>

  <!-- ════════ RIGHT ELEVATOR DOOR ════════ -->
  <div 
    id="curtain-right" 
    class="absolute top-0 left-1/2 w-1/2 h-full overflow-hidden"
    style="transition: transform 1350ms cubic-bezier(0.2, 1, 0.3, 1), opacity 450ms ease-out 850ms;"
  >
    <!-- Background realistic grey elevator door texture -->
    <img 
      src={`${baseUrl}/images/user-door-right-extended.webp`} 
      alt="Puerta derecha de ascensor metálico"
      class="absolute inset-0 w-full h-full object-cover object-left pointer-events-none brightness-[0.98]"
      loading="eager"
      decoding="async"
    />

    <!-- 200% width container offset by -100% so its center aligns with 0px (the seam) with subpixel precision -->
    <div class="absolute top-0 -left-[100%] w-[200%] h-full flex flex-col items-center justify-center pointer-events-none">
      <div class="w-48 sm:w-64 md:w-80 lg:w-96 text-white filter drop-shadow-[0_4px_25px_rgba(0,0,0,0.95)] drop-shadow-[0_0_35px_rgba(255,255,255,0.25)]">
        <Logo class="w-full h-auto text-white" />
      </div>

      <!-- Subtle skip text -->
      <div class="mt-8 sm:mt-12 text-[10px] sm:text-xs font-semibold tracking-widest text-slate-300/80 uppercase drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
        Toca para abrir
      </div>
    </div>

    <!-- ─── Retro Green LED Screen Overlay (Exact Screen Area: Left 76.55%, Top 27.75%, Width 15.31%, Height 4.24%) ─── -->
    <div class="absolute left-[76.55%] top-[27.75%] w-[15.31%] h-[4.24%] flex flex-col items-center justify-center pointer-events-none select-none overflow-hidden bg-[#070a07] rounded-[2px] shadow-[inset_0_1px_4px_rgba(0,0,0,0.95)]">
      <div class="flex flex-col items-center justify-center leading-none">
        <span 
          id="led-arrow" 
          class="text-[9px] sm:text-[11px] md:text-xs font-black text-emerald-400 drop-shadow-[0_0_8px_#34d399] leading-none mb-[1px] animate-pulse"
        >
          ▲
        </span>
        <span 
          id="led-digit" 
          class="font-mono text-xs sm:text-sm md:text-base font-black text-emerald-400 tracking-tighter drop-shadow-[0_0_10px_#34d399] leading-none"
        >
          1
        </span>
      </div>
    </div>

    <!-- ─── Button 4 Glowing Active Ring Overlay (Exact Center: Left 83.9%, Top 47.5%, Diameter 10.75%) ─── -->
    <div 
      id="btn-4-glow"
      class="absolute left-[83.9%] top-[47.5%] -translate-x-1/2 -translate-y-1/2 w-[10.75%] aspect-square rounded-full border-2 border-emerald-400 shadow-[0_0_16px_#22c55e,0_0_30px_rgba(34,197,94,0.7),inset_0_0_8px_#22c55e] bg-emerald-500/20 animate-pulse pointer-events-none"
    ></div>

  </div>
</div>

<script is:inline>
  (() => {
    const curtain = document.getElementById('intro-curtain');
    const left = document.getElementById('curtain-left');
    const right = document.getElementById('curtain-right');
    const ledDigit = document.getElementById('led-digit');
    const ledArrow = document.getElementById('led-arrow');
    const btn4Glow = document.getElementById('btn-4-glow');

    if (!curtain || !left || !right) return;

    let hasOpened = false;

    function openDoors() {
      if (hasOpened) return;
      hasOpened = true;
      curtain.style.pointerEvents = 'none';

      // Split open the grey metallic elevator doors to left and right
      left.style.transform = 'translate3d(-100%, 0, 0)';
      left.style.opacity = '0';
      right.style.transform = 'translate3d(100%, 0, 0)';
      right.style.opacity = '0';

      // Clean up from DOM to ensure zero memory or scroll interference
      setTimeout(() => {
        curtain.remove();
      }, 1400);
    }

    // Ascent sequence of floors: 1 -> 2 -> 3 -> 4
    // Gives users plenty of time to appreciate the animation
    setTimeout(() => {
      if (ledDigit) ledDigit.textContent = '2';
    }, 750);

    setTimeout(() => {
      if (ledDigit) ledDigit.textContent = '3';
    }, 1500);

    // Reached Floor 4!
    setTimeout(() => {
      if (ledDigit) {
        ledDigit.textContent = '4';
        ledDigit.className = 'font-mono text-xs sm:text-sm md:text-base font-black text-amber-300 tracking-tighter drop-shadow-[0_0_14px_#f59e0b] leading-none';
      }
      if (ledArrow) {
        ledArrow.textContent = '★';
        ledArrow.className = 'text-[9px] sm:text-[11px] md:text-xs font-black text-amber-300 drop-shadow-[0_0_14px_#f59e0b] leading-none mb-[1px]';
      }
      if (btn4Glow) {
        btn4Glow.className = 'absolute left-[83.9%] top-[47.5%] -translate-x-1/2 -translate-y-1/2 w-[10.75%] aspect-square rounded-full border-2 border-amber-300 shadow-[0_0_24px_#f59e0b,0_0_40px_rgba(245,158,11,0.8),inset_0_0_12px_#f59e0b] bg-amber-500/25 pointer-events-none';
      }
    }, 2250);

    // Hold at Floor 4 for 800ms so arrival is appreciated, then open the doors smoothly
    setTimeout(openDoors, 3050);

    // Instant skip on tap, click, or scroll
    curtain.addEventListener('click', openDoors, { once: true });
    curtain.addEventListener('touchstart', openDoors, { once: true, passive: true });
    window.addEventListener('scroll', openDoors, { once: true, passive: true });
  })();
</script>
