---
import Logo from './Logo.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- ════════ ULTRA-REALISTIC ELEVATOR ASCENT & SPLIT DOORS INTRO ════════ -->
<div 
  id="intro-curtain" 
  class="fixed inset-0 z-[9999] w-screen h-screen h-[100dvh] overflow-hidden select-none cursor-pointer"
  style="touch-action: pan-y;"
  aria-hidden="true"
>
  <!-- ════════ LEFT ELEVATOR DOOR (Left 50% of Screen + 1px overlap) ════════ -->
  <div 
    id="curtain-left" 
    class="absolute top-0 left-0 w-[calc(50%+1px)] h-full overflow-hidden bg-[#18191B] flex justify-end"
    style="transition: transform 1350ms cubic-bezier(0.2, 1, 0.3, 1), opacity 450ms ease-out 850ms;"
  >
    <!-- Left door graphic container: perfectly preserves 309/1374 proportion -->
    <div class="relative h-full aspect-[309/1374] min-w-full sm:min-w-0 max-w-none flex-shrink-0">
      <!-- Stainless steel left door texture -->
      <img 
        src={`${baseUrl}/images/elevator-door-left.webp`} 
        alt="Puerta izquierda de ascensor metálico"
        class="w-full h-full object-cover object-right pointer-events-none brightness-[0.98]"
        loading="eager"
        decoding="sync"
      />
    </div>

    <!-- Left half of logo: center aligned exactly at right: 0 (the seam) -->
    <div 
      id="logo-half-left" 
      class="absolute inset-y-0 w-[100vw] flex flex-col items-center justify-center pointer-events-none opacity-0"
      style="left: calc(100% - 50vw);"
    >
      <div class="w-48 sm:w-64 md:w-80 lg:w-96 text-white filter drop-shadow-[0_4px_25px_rgba(0,0,0,0.95)] drop-shadow-[0_0_35px_rgba(255,255,255,0.25)]">
        <Logo class="w-full h-auto text-white" />
      </div>
      <div class="mt-8 sm:mt-12 text-[10px] sm:text-xs font-semibold tracking-widest text-slate-300/80 uppercase drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
        Toca para abrir
      </div>
    </div>
  </div>

  <!-- ════════ RIGHT ELEVATOR DOOR (Right 50% of Screen) ════════ -->
  <div 
    id="curtain-right" 
    class="absolute top-0 left-1/2 w-1/2 h-full overflow-hidden bg-[#18191B] flex justify-start"
    style="transition: transform 1350ms cubic-bezier(0.2, 1, 0.3, 1), opacity 450ms ease-out 850ms;"
  >
    <!-- Right door graphic container: perfectly preserves 309/1374 proportion -->
    <div class="relative h-full aspect-[309/1374] min-w-full sm:min-w-0 max-w-none flex-shrink-0">
      <!-- Stainless steel right door texture with control panel -->
      <img 
        src={`${baseUrl}/images/elevator-door-right.webp`} 
        alt="Puerta derecha de ascensor metálico"
        class="w-full h-full object-cover object-left pointer-events-none brightness-[0.98]"
        loading="eager"
        decoding="sync"
      />

      <!-- ─── Retro Green LED Screen Overlay (Pinned to exact coordinates of right door) ─── -->
      <div class="absolute left-[76.05%] top-[28.24%] w-[14.24%] h-[4.37%] flex flex-col items-center justify-center pointer-events-none select-none overflow-hidden bg-[#070a07] rounded-[2px] shadow-[inset_0_1px_4px_rgba(0,0,0,0.95)]">
        <div class="flex flex-col items-center justify-center leading-none">
          <span 
            id="led-arrow" 
            class="text-[9px] sm:text-[11px] md:text-xs font-black text-emerald-400 drop-shadow-[0_0_8px_#34d399] leading-none mb-[1px] animate-pulse"
          >
            ▲
          </span>
          <span 
            id="led-digit" 
            class="font-mono text-xs sm:text-sm md:text-base font-black text-emerald-400 tracking-tighter drop-shadow-[0_0_10px_#34d399] leading-none"
          >
            1
          </span>
        </div>
      </div>

      <!-- ─── Button 4 Glowing Active Ring Overlay (Pinned to exact coordinates of right door) ─── -->
      <div 
        id="btn-4-glow"
        class="absolute left-[84.02%] top-[47.53%] -translate-x-1/2 -translate-y-1/2 w-[10.36%] aspect-square rounded-full border-2 border-emerald-400 shadow-[0_0_16px_#22c55e,0_0_30px_rgba(34,197,94,0.7),inset_0_0_8px_#22c55e] bg-emerald-500/20 animate-pulse pointer-events-none"
      ></div>
    </div>

    <!-- Right half of logo: center aligned exactly at left: 0 (the seam) -->
    <div 
      id="logo-half-right" 
      class="absolute inset-y-0 w-[100vw] flex flex-col items-center justify-center pointer-events-none opacity-0"
      style="left: -50vw;"
    >
      <div class="w-48 sm:w-64 md:w-80 lg:w-96 text-white filter drop-shadow-[0_4px_25px_rgba(0,0,0,0.95)] drop-shadow-[0_0_35px_rgba(255,255,255,0.25)]">
        <Logo class="w-full h-auto text-white" />
      </div>
      <div class="mt-8 sm:mt-12 text-[10px] sm:text-xs font-semibold tracking-widest text-slate-300/80 uppercase drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
        Toca para abrir
      </div>
    </div>
  </div>

  <!-- ════════ UNIFIED PRISTINE LOGO (Displayed while doors are closed: ZERO seam, ZERO gap) ════════ -->
  <div 
    id="curtain-logo-unified" 
    class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none z-20"
  >
    <div class="w-48 sm:w-64 md:w-80 lg:w-96 text-white filter drop-shadow-[0_4px_25px_rgba(0,0,0,0.95)] drop-shadow-[0_0_35px_rgba(255,255,255,0.25)]">
      <Logo class="w-full h-auto text-white" />
    </div>
    <div class="mt-8 sm:mt-12 text-[10px] sm:text-xs font-semibold tracking-widest text-slate-300/80 uppercase drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
      Toca para abrir
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const curtain = document.getElementById('intro-curtain');
    const left = document.getElementById('curtain-left');
    const right = document.getElementById('curtain-right');
    const unifiedLogo = document.getElementById('curtain-logo-unified');
    const logoHalfLeft = document.getElementById('logo-half-left');
    const logoHalfRight = document.getElementById('logo-half-right');
    const ledDigit = document.getElementById('led-digit');
    const ledArrow = document.getElementById('led-arrow');
    const btn4Glow = document.getElementById('btn-4-glow');

    if (!curtain || !left || !right) return;

    // Prevent background scrolling while elevator curtain is active
    document.body.style.overflow = 'hidden';
    document.documentElement.style.overflow = 'hidden';

    let hasOpened = false;

    function openDoors() {
      if (hasOpened) return;
      hasOpened = true;
      curtain.style.pointerEvents = 'none';

      // Instantly switch from unified logo to door split halves as doors pull apart
      if (unifiedLogo) unifiedLogo.style.display = 'none';
      if (logoHalfLeft) logoHalfLeft.style.opacity = '1';
      if (logoHalfRight) logoHalfRight.style.opacity = '1';

      // Split open the grey metallic elevator doors to left and right
      left.style.transform = 'translate3d(-100%, 0, 0)';
      left.style.opacity = '0';
      right.style.transform = 'translate3d(100%, 0, 0)';
      right.style.opacity = '0';

      // Restore scroll
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';

      // Clean up from DOM to ensure zero memory or scroll interference
      setTimeout(() => {
        curtain.remove();
      }, 1400);
    }

    // Ascent sequence of floors: 1 -> 2 -> 3 -> 4
    setTimeout(() => {
      if (ledDigit) ledDigit.textContent = '2';
    }, 750);

    setTimeout(() => {
      if (ledDigit) ledDigit.textContent = '3';
    }, 1500);

    // Reached Floor 4!
    setTimeout(() => {
      if (ledDigit) {
        ledDigit.textContent = '4';
        ledDigit.className = 'font-mono text-xs sm:text-sm md:text-base font-black text-amber-300 tracking-tighter drop-shadow-[0_0_14px_#f59e0b] leading-none';
      }
      if (ledArrow) {
        ledArrow.textContent = '★';
        ledArrow.className = 'text-[9px] sm:text-[11px] md:text-xs font-black text-amber-300 drop-shadow-[0_0_14px_#f59e0b] leading-none mb-[1px]';
      }
      if (btn4Glow) {
        btn4Glow.className = 'absolute left-[84.02%] top-[47.53%] -translate-x-1/2 -translate-y-1/2 w-[10.36%] aspect-square rounded-full border-2 border-amber-300 shadow-[0_0_24px_#f59e0b,0_0_40px_rgba(245,158,11,0.8),inset_0_0_12px_#f59e0b] bg-amber-500/25 pointer-events-none';
      }
    }, 2250);

    // Hold at Floor 4 for 800ms so arrival is appreciated, then open the doors smoothly
    setTimeout(openDoors, 3050);

    // Instant skip on tap, click, or scroll
    curtain.addEventListener('click', openDoors, { once: true });
    curtain.addEventListener('touchstart', openDoors, { once: true, passive: true });
    window.addEventListener('scroll', openDoors, { once: true, passive: true });
  })();
</script>
