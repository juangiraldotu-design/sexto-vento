---
import Logo from './Logo.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- ════════ ULTRA-REALISTIC ELEVATOR ASCENT & SPLIT DOORS INTRO ════════ -->
<button
  type="button"
  id="intro-curtain" 
  class="fixed inset-0 z-[9999] w-screen h-screen h-[100dvh] overflow-hidden select-none cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-amber-300"
  style="touch-action: manipulation;"
  aria-label="Abrir las puertas y entrar a Sexto Vento"
>
  <!-- ════════ LEFT ELEVATOR DOOR (Left 50% of Screen + 1px overlap) ════════ -->
  <div 
    id="curtain-left" 
    class="absolute top-0 left-0 w-[calc(50%+1px)] h-full overflow-hidden bg-[#18191B] flex justify-end"
    style="transition: transform 700ms cubic-bezier(0.2, 1, 0.3, 1), opacity 300ms ease-out 400ms;"
  >
    <!-- Left door graphic container: perfectly preserves 309/1374 proportion -->
    <div class="relative h-full aspect-[309/1374] min-w-full sm:min-w-0 max-w-none flex-shrink-0">
      <!-- Stainless steel left door SVG (locked to 309x1374 coordinate space) -->
    <!-- Portrait Mode (Mobile / Vertical Viewports: 309x1374) -->
    <div class="door-portrait w-full h-full">
      <svg viewBox="0 0 309 1374" class="w-full h-full block pointer-events-none brightness-[0.98]" preserveAspectRatio="xMaxYMid slice">
        <image href={`${baseUrl}/images/elevator-door-left.webp`} x="0" y="0" width="309" height="1374" />
      </svg>
    </div>

    <!-- Landscape / Desktop Mode (PC Widescreen / Tablets in landscape: 688x768) -->
    <div class="door-landscape w-full h-full">
      <svg viewBox="0 0 688 768" class="w-full h-full block pointer-events-none brightness-[0.98]" preserveAspectRatio="xMaxYMid slice">
        <image href={`${baseUrl}/images/elevator-desktop-left.webp`} x="0" y="0" width="688" height="768" />
      </svg>
    </div>

    <!-- Left half of logo: center aligned exactly at right: 0 (the seam) -->
    <div 
      id="logo-half-left" 
      class="absolute inset-y-0 w-[100vw] flex flex-col items-center justify-center pointer-events-none opacity-0"
      style="left: calc(100% - 50vw);"
    >
      <div class="w-48 sm:w-64 md:w-80 lg:w-96 text-white filter drop-shadow-[0_4px_25px_rgba(0,0,0,0.95)] drop-shadow-[0_0_35px_rgba(255,255,255,0.25)]">
        <Logo class="w-full h-auto text-white" />
      </div>
      <div class="mt-8 sm:mt-12 text-[10px] sm:text-xs font-semibold tracking-widest text-slate-300/80 uppercase drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
        <span class="inline sm:hidden">Toca para abrir</span>
        <span class="hidden sm:inline">Haz clic para entrar</span>
      </div>
    </div>
  </div>

  <!-- ════════ RIGHT ELEVATOR DOOR (Right 50% of Screen) ════════ -->
  <div 
    id="curtain-right" 
    class="absolute top-0 left-1/2 w-1/2 h-full overflow-hidden bg-[#18191B] flex justify-start"
    style="transition: transform 700ms cubic-bezier(0.2, 1, 0.3, 1), opacity 300ms ease-out 400ms;"
  >
    <!-- Right door graphic container: perfectly preserves 309/1374 proportion -->
    <div class="relative h-full aspect-[309/1374] min-w-full sm:min-w-0 max-w-none flex-shrink-0">
      <!-- Stainless steel right door SVG with coordinate-locked LED screen & Button 4 overlay -->
    <!-- Portrait Mode (Mobile / Vertical Viewports: 309x1374) -->
    <div class="door-portrait w-full h-full">
      <svg viewBox="0 0 309 1374" class="w-full h-full block pointer-events-none brightness-[0.98]" preserveAspectRatio="xMinYMid slice">
        <image href={`${baseUrl}/images/elevator-door-right.webp`} x="0" y="0" width="309" height="1374" />
        
        <!-- ─── Retro LED Screen Overlay (Pinned precisely inside display bezel at x:257, y:388..448) ─── -->
        <!-- Retro LED Screen Overlay (Mobile) -->
        <text 
          id="led-arrow"
          class="led-arrow" 
          x="257" 
          y="412" 
          text-anchor="middle" 
          font-family="monospace" 
          font-size="13" 
          font-weight="900" 
          fill="#34d399" 
          style="filter: drop-shadow(0 0 6px #34d399); transition: fill 300ms ease, filter 300ms ease;"
        >▲</text>
        <text 
          id="led-digit"
          class="led-digit" 
          x="257" 
          y="438" 
          text-anchor="middle" 
          font-family="monospace" 
          font-size="20" 
          font-weight="900" 
          fill="#34d399" 
          style="filter: drop-shadow(0 0 8px #34d399); transition: fill 300ms ease, filter 300ms ease;"
        >1</text>

        <!-- ─── Button 4 Glowing Active Ring Overlay (Locked permanently to cx:259.6, cy:653.1) ─── -->
        <!-- Button 4 Glowing Active Ring Overlay (Mobile) -->
        <circle 
          id="btn-4-glow"
          class="btn-4-glow" 
          cx="259.6" 
          cy="653.1" 
          r="16" 
          fill="rgba(34,197,94,0.25)" 
          stroke="#34d399" 
          stroke-width="2.5" 
          style="filter: drop-shadow(0 0 10px #22c55e); transition: all 300ms ease;"
        />
      </svg>
    </div>

    <!-- Landscape / Desktop Mode (PC Widescreen / Tablets in landscape: 688x768) -->
    <div class="door-landscape w-full h-full">
      <svg viewBox="0 0 688 768" class="w-full h-full block pointer-events-none brightness-[0.98]" preserveAspectRatio="xMinYMid slice">
        <image href={`${baseUrl}/images/elevator-desktop-right.webp`} x="0" y="0" width="688" height="768" />
        
        <!-- Retro LED Screen Overlay (Desktop Widescreen) -->
        <text 
          class="led-arrow" 
          x="195" 
          y="173" 
          text-anchor="middle" 
          font-family="monospace" 
          font-size="12" 
          font-weight="900" 
          fill="#34d399" 
          style="filter: drop-shadow(0 0 6px #34d399); transition: fill 300ms ease, filter 300ms ease;"
        >▲</text>
        <text 
          class="led-digit" 
          x="195" 
          y="196" 
          text-anchor="middle" 
          font-family="monospace" 
          font-size="18" 
          font-weight="900" 
          fill="#34d399" 
          style="filter: drop-shadow(0 0 8px #34d399); transition: fill 300ms ease, filter 300ms ease;"
        >1</text>

        <!-- Button 4 Glowing Active Ring Overlay (Desktop Widescreen) -->
        <circle 
          class="btn-4-glow" 
          cx="196" 
          cy="358" 
          r="13" 
          fill="rgba(34,197,94,0.25)" 
          stroke="#34d399" 
          stroke-width="2.5" 
          style="filter: drop-shadow(0 0 10px #22c55e); transition: all 300ms ease;"
        />
      </svg>
    </div>

    <!-- Right half of logo: center aligned exactly at left: 0 (the seam) -->
    <div 
      id="logo-half-right" 
      class="absolute inset-y-0 w-[100vw] flex flex-col items-center justify-center pointer-events-none opacity-0"
      style="left: -50vw;"
    >
      <div class="w-48 sm:w-64 md:w-80 lg:w-96 text-white filter drop-shadow-[0_4px_25px_rgba(0,0,0,0.95)] drop-shadow-[0_0_35px_rgba(255,255,255,0.25)]">
        <Logo class="w-full h-auto text-white" />
      </div>
      <div class="mt-8 sm:mt-12 text-[10px] sm:text-xs font-semibold tracking-widest text-slate-300/80 uppercase drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
        <span class="inline sm:hidden">Toca para abrir</span>
        <span class="hidden sm:inline">Haz clic para entrar</span>
      </div>
    </div>
  </div>

  <div id="intro-seam-light" class="absolute inset-y-0 left-1/2 z-10 w-px -translate-x-1/2 bg-amber-200 opacity-0 pointer-events-none"></div>

  <!-- ════════ UNIFIED PRISTINE LOGO (Displayed while doors are closed: ZERO seam, ZERO gap) ════════ -->
  <div 
    id="curtain-logo-unified" 
    class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none z-20"
  >
    <div class="w-48 sm:w-64 md:w-80 lg:w-96 text-white filter drop-shadow-[0_4px_25px_rgba(0,0,0,0.95)] drop-shadow-[0_0_35px_rgba(255,255,255,0.25)]">
      <Logo class="w-full h-auto text-white" />
    </div>
    <div class="mt-8 sm:mt-12 text-[10px] sm:text-xs font-semibold tracking-widest text-slate-300/80 uppercase drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
      <span class="inline sm:hidden">Toca para abrir</span>
      <span class="hidden sm:inline">Haz clic para entrar</span>
    </div>
  </div>
</button>

<style>
  .door-portrait {
    display: block;
  }
  .door-landscape {
    display: none;
  }

  @media (min-aspect-ratio: 1/1) {
    .door-portrait {
      display: none !important;
    }
    .door-landscape {
      display: block !important;
    }
  }

  #intro-curtain.is-arriving {
    animation: elevator-arrival 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  #intro-curtain.is-arriving #intro-seam-light {
    opacity: 0.85;
    box-shadow: 0 0 18px 4px rgba(251, 191, 36, 0.55);
  }

  #intro-curtain.is-opening #intro-seam-light {
    animation: seam-release 700ms ease-out both;
  }

  @keyframes elevator-arrival {
    0%, 100% { transform: translate3d(0, 0, 0); }
    28% { transform: translate3d(0, 3px, 0); }
    55% { transform: translate3d(0, -2px, 0); }
    78% { transform: translate3d(0, 1px, 0); }
  }

  @keyframes seam-release {
    0% { opacity: 0.9; transform: translateX(-50%) scaleX(1); }
    45% { opacity: 1; transform: translateX(-50%) scaleX(28); box-shadow: 0 0 42px 10px rgba(251, 191, 36, 0.75); }
    100% { opacity: 0; transform: translateX(-50%) scaleX(80); }
  }
</style>

<script is:inline>
  (() => {
    const curtain = document.getElementById('intro-curtain');
    const left = document.getElementById('curtain-left');
    const right = document.getElementById('curtain-right');
    const unifiedLogo = document.getElementById('curtain-logo-unified');
    const logoHalfLeft = document.getElementById('logo-half-left');
    const logoHalfRight = document.getElementById('logo-half-right');
    const ledDigit = document.getElementById('led-digit');
    const ledArrow = document.getElementById('led-arrow');
    const btn4Glow = document.getElementById('btn-4-glow');
    const ledDigits = document.querySelectorAll('.led-digit');
    const ledArrows = document.querySelectorAll('.led-arrow');
    const btn4Glows = document.querySelectorAll('.btn-4-glow');

    if (!curtain || !left || !right) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Show the elevator on every page load. Visitors who prefer reduced motion
    // enter directly without the ascent or door-opening animation.
    if (prefersReducedMotion) {
      curtain.remove();
      return;
    }

    // Prevent background scrolling while elevator curtain is active
    document.body.style.overflow = 'hidden';
    document.documentElement.style.overflow = 'hidden';
    curtain.focus({ preventScroll: true });

    let hasOpened = false;

    function openDoors() {
      if (hasOpened) return;
      hasOpened = true;
      curtain.style.pointerEvents = 'none';
      curtain.classList.remove('is-arriving');
      curtain.classList.add('is-opening');
      document.documentElement.classList.add('intro-opening');

      // Instantly switch from unified logo to door split halves as doors pull apart
      if (unifiedLogo) unifiedLogo.style.display = 'none';
      if (logoHalfLeft) logoHalfLeft.style.opacity = '1';
      if (logoHalfRight) logoHalfRight.style.opacity = '1';

      // Split open the grey metallic elevator doors to left and right
      left.style.transform = 'translate3d(-100%, 0, 0)';
      left.style.opacity = '0';
      right.style.transform = 'translate3d(100%, 0, 0)';
      right.style.opacity = '0';

      // Restore scroll
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';

      // Clean up from DOM to ensure zero memory or scroll interference
      setTimeout(() => {
        curtain.remove();
        document.documentElement.classList.remove('intro-opening');
      }, 760);
    }

    // Ascent sequence of floors: 1 -> 2 -> 3 -> 4
    setTimeout(() => {
      if (ledDigit) ledDigit.textContent = '2';
      ledDigits.forEach(el => el.textContent = '2');
    }, 200);

    setTimeout(() => {
      if (ledDigit) ledDigit.textContent = '3';
      ledDigits.forEach(el => el.textContent = '3');
    }, 420);

    // Reached Floor 4!
    setTimeout(() => {
      if (ledDigit) {
        ledDigit.textContent = '4';
        ledDigit.setAttribute('fill', '#fde047');
        ledDigit.style.filter = 'drop-shadow(0 0 14px #f59e0b)';
      }
      if (ledArrow) {
        ledArrow.textContent = '★';
        ledArrow.setAttribute('fill', '#fde047');
        ledArrow.style.filter = 'drop-shadow(0 0 14px #f59e0b)';
      }
      if (btn4Glow) {
        btn4Glow.setAttribute('fill', 'rgba(245, 158, 11, 0.35)');
        btn4Glow.setAttribute('stroke', '#fbbf24');
        btn4Glow.style.filter = 'drop-shadow(0 0 20px #f59e0b)';
      }
      ledDigits.forEach(el => {
        el.textContent = '4';
        el.setAttribute('fill', '#fde047');
        el.style.filter = 'drop-shadow(0 0 14px #f59e0b)';
      });
      ledArrows.forEach(el => {
        el.textContent = '★';
        el.setAttribute('fill', '#fde047');
        el.style.filter = 'drop-shadow(0 0 14px #f59e0b)';
      });
      btn4Glows.forEach(el => {
        el.setAttribute('fill', 'rgba(245, 158, 11, 0.35)');
        el.setAttribute('stroke', '#fbbf24');
        el.style.filter = 'drop-shadow(0 0 20px #f59e0b)';
      });
      curtain.classList.add('is-arriving');
    }, 650);

    // The ascent and arrival stay short; the complete reveal takes about 1.65 seconds.
    setTimeout(openDoors, 900);

    // Instant skip on click, Enter/Space (native button behavior), Escape, or scroll.
    curtain.addEventListener('click', openDoors, { once: true });
    curtain.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') openDoors();
    }, { once: true });
    window.addEventListener('scroll', openDoors, { once: true, passive: true });
  })();
</script>
