---
import Logo from './Logo.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div
  id="intro-curtain"
  role="dialog"
  aria-modal="true"
  aria-labelledby="intro-title"
  class="intro-curtain"
>
  <h2 id="intro-title" class="sr-only">Llegando a Sexto Vento, piso 4</h2>
  <p id="intro-status" class="sr-only" aria-live="polite">Ascensor subiendo al piso 4</p>

  <div class="intro-stage" aria-hidden="true">
    <div id="curtain-left" class="intro-door intro-door--left">
      <picture class="intro-picture">
        <source
          media="(min-aspect-ratio: 1/1)"
          type="image/webp"
          srcset={`${baseUrl}/images/elevator-desktop-left.webp`}
        />
        <source
          media="(min-aspect-ratio: 1/1)"
          type="image/jpeg"
          srcset={`${baseUrl}/images/elevator-desktop-left.jpg`}
        />
        <source
          type="image/webp"
          srcset={`${baseUrl}/images/elevator-door-left.webp`}
        />
        <img
          class="intro-door-image"
          src={`${baseUrl}/images/elevator-door-left.jpg`}
          width="309"
          height="1374"
          alt=""
          decoding="async"
          fetchpriority="high"
          draggable="false"
          data-intro-image
        />
      </picture>
    </div>

    <div id="curtain-right" class="intro-door intro-door--right">
      <picture class="intro-picture">
        <source
          media="(min-aspect-ratio: 1/1)"
          type="image/webp"
          srcset={`${baseUrl}/images/elevator-desktop-right.webp`}
        />
        <source
          media="(min-aspect-ratio: 1/1)"
          type="image/jpeg"
          srcset={`${baseUrl}/images/elevator-desktop-right.jpg`}
        />
        <source
          type="image/webp"
          srcset={`${baseUrl}/images/elevator-door-right.webp`}
        />
        <img
          class="intro-door-image"
          src={`${baseUrl}/images/elevator-door-right.jpg`}
          width="309"
          height="1374"
          alt=""
          decoding="async"
          fetchpriority="high"
          draggable="false"
          data-intro-image
        />
      </picture>

      <div class="intro-panel-overlay" aria-hidden="true">
        <span class="intro-panel-arrow">▲</span>
        <span class="intro-panel-floor">1</span>
        <span class="intro-floor-button">
          <span class="intro-floor-button-core">
            <span class="intro-floor-button-label">4</span>
          </span>
        </span>
      </div>
    </div>

    <div class="intro-shade"></div>
    <div id="intro-seam-light" class="intro-seam"></div>

    <div class="intro-hud">
      <div class="intro-floor-display">
        <span class="intro-floor-label">Piso</span>
        <span class="intro-floor-number">1</span>
        <span class="intro-floor-arrow" aria-hidden="true">▲</span>
      </div>

      <div class="intro-brand">
        <div class="intro-logo">
          <Logo class="w-full h-auto text-white" />
        </div>
        <p class="intro-kicker">Rooftop · Roldanillo</p>
      </div>
    </div>
  </div>

  <button id="intro-skip" class="intro-skip" type="button">
    <span class="intro-skip-mobile">Toca para entrar</span>
    <span class="intro-skip-desktop">Haz clic para entrar</span>
  </button>
</div>

<style>
  .intro-curtain {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    width: 100vw;
    width: var(--intro-width, 100vw);
    height: 100vh;
    height: var(--intro-height, 100vh);
    overflow: hidden;
    isolation: isolate;
    overscroll-behavior: none;
    touch-action: manipulation;
    background: #0b0c0d;
    opacity: 1;
    visibility: visible;
    transition: background-color 180ms ease-out, opacity 160ms ease-out 760ms,
      visibility 0s linear 940ms;
  }

  .intro-curtain[hidden] {
    display: none;
  }

  .intro-stage,
  .intro-door,
  .intro-picture,
  .intro-shade,
  .intro-hud {
    position: absolute;
    top: 0;
    bottom: 0;
  }

  .intro-stage,
  .intro-shade,
  .intro-hud {
    left: 0;
    right: 0;
  }

  .intro-stage {
    overflow: hidden;
  }

  .intro-door {
    top: 0;
    bottom: 0;
    width: calc(50% + 1px);
    overflow: hidden;
    background: #17191b;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    will-change: transform;
    -webkit-transition: -webkit-transform 1040ms cubic-bezier(0.72, 0, 0.2, 1);
    transition: transform 1040ms cubic-bezier(0.72, 0, 0.2, 1);
  }

  .intro-door--left {
    left: 0;
    z-index: 1;
  }

  .intro-door--right {
    right: 0;
    z-index: 1;
  }

  .intro-picture {
    left: 0;
    right: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .intro-door-image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    user-select: none;
    pointer-events: none;
    backface-visibility: hidden;
    transform: translate3d(0, 0, 0) scale(1.002);
    will-change: transform;
  }

  .intro-door--left .intro-door-image {
    object-position: right center;
  }

  .intro-door--right .intro-door-image {
    object-position: left center;
  }

  .intro-panel-overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    backface-visibility: hidden;
    will-change: transform;
    transform: translate3d(0, 0, 0) scale(1.002);
    opacity: 0;
  }

  .intro-curtain.is-panel-ready .intro-panel-overlay {
    opacity: 1;
  }

  .intro-panel-arrow,
  .intro-panel-floor {
    position: absolute;
    display: block;
    left: var(--panel-x, 0px);
    color: #86efac;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 900;
    line-height: 1;
    text-align: center;
    text-shadow: 0 0 7px #22c55e;
    transform: translate3d(-50%, -50%, 0);
  }

  .intro-panel-arrow {
    top: var(--panel-arrow-y, 0px);
    font-size: var(--panel-arrow-size, 10px);
  }

  .intro-panel-floor {
    top: var(--panel-floor-y, 0px);
    font-size: var(--panel-floor-size, 14px);
  }

  .intro-floor-button {
    position: absolute;
    left: var(--panel-button-x, 0px);
    top: var(--panel-button-y, 0px);
    width: var(--panel-button-size, 17px);
    height: var(--panel-button-size, 17px);
    transform: translate3d(-50%, -50%, 0);
  }

  .intro-floor-button::before {
    position: absolute;
    top: -28%;
    right: -28%;
    bottom: -28%;
    left: -28%;
    content: '';
    border: 1px solid rgba(253, 230, 138, 0);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.82);
  }

  .intro-floor-button-core {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: rgba(226, 232, 240, 0.82);
    background: rgba(8, 12, 10, 0.72);
    border: 1px solid rgba(203, 213, 225, 0.68);
    border-radius: 50%;
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.12);
    transition: color 160ms ease-out, background-color 160ms ease-out,
      border-color 160ms ease-out, box-shadow 160ms ease-out;
  }

  .intro-floor-button-label {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: var(--panel-button-font-size, 11px);
    font-weight: 900;
    line-height: 1;
    pointer-events: none;
  }

  .intro-shade {
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% 46%, rgba(255, 255, 255, 0.03), transparent 34%),
      linear-gradient(180deg, rgba(3, 4, 5, 0.16), rgba(3, 4, 5, 0.3));
    opacity: 1;
    transition: opacity 240ms ease-out;
  }

  .intro-seam {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: 3;
    width: 1px;
    pointer-events: none;
    background: rgba(254, 243, 199, 0.88);
    box-shadow: 0 0 15px 3px rgba(245, 158, 11, 0.34);
    opacity: 0.55;
    transform: translate3d(-50%, 0, 0) scaleX(1);
    transform-origin: center;
    will-change: transform, opacity;
  }

  .intro-hud {
    z-index: 4;
    display: grid;
    grid-template-rows: auto 1fr;
    justify-items: center;
    padding: 1rem 1rem 5rem;
    padding:
      max(1rem, env(safe-area-inset-top))
      max(1rem, env(safe-area-inset-right))
      max(5rem, calc(env(safe-area-inset-bottom) + 4.25rem))
      max(1rem, env(safe-area-inset-left));
    pointer-events: none;
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    transition: opacity 220ms ease-out, transform 300ms ease-out;
  }

  .intro-floor-display {
    position: relative;
    display: inline-grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    column-gap: 0.45rem;
    min-width: 7.8rem;
    padding: 0.62rem 1.9rem 0.62rem 0.9rem;
    color: #86efac;
    background: linear-gradient(180deg, rgba(1, 8, 6, 0.96), rgba(2, 15, 10, 0.92));
    border: 1px solid rgba(226, 232, 240, 0.32);
    border-radius: 0.75rem;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 8px 30px rgba(0, 0, 0, 0.52),
      0 0 18px rgba(34, 197, 94, 0.14);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    text-transform: uppercase;
  }

  .intro-floor-label {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    opacity: 0.84;
  }

  .intro-floor-number {
    font-size: 1.65rem;
    line-height: 1;
    font-weight: 900;
    text-shadow: 0 0 12px currentColor;
    font-variant-numeric: tabular-nums;
  }

  .intro-floor-arrow {
    position: absolute;
    top: 50%;
    right: 0.75rem;
    font-size: 0.68rem;
    transform: translateY(-50%);
    filter: drop-shadow(0 0 5px currentColor);
  }

  .intro-brand {
    align-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 82vw;
    max-width: 28rem;
    transform: translateY(-2vh);
  }

  .intro-logo {
    width: 9.5rem;
    width: clamp(9.5rem, 34vmin, 23rem);
    color: #fff;
    filter: drop-shadow(0 6px 20px rgba(0, 0, 0, 0.86));
  }

  .intro-kicker {
    margin: 1rem 0 0;
    margin: clamp(1rem, 2.8vmin, 1.6rem) 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.68rem;
    font-size: clamp(0.65rem, 1.4vmin, 0.78rem);
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.95);
  }

  .intro-skip {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 5;
    min-height: 2.75rem;
    padding: 0.72rem 1.15rem;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(10, 10, 11, 0.66);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 8px 24px rgba(0, 0, 0, 0.45);
    font: inherit;
    font-size: 0.69rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    opacity: 1;
    transform: translate3d(-50%, 0, 0);
    transition: opacity 180ms ease-out, transform 180ms ease-out, background-color 180ms ease-out;
  }

  .intro-skip:hover {
    background: rgba(26, 20, 16, 0.82);
  }

  .intro-skip:focus-visible {
    outline: 2px solid #fcd34d;
    outline-offset: 3px;
  }

  .intro-skip-desktop {
    display: none;
  }

  .intro-curtain.is-riding .intro-door-image,
  .intro-curtain.is-riding .intro-panel-overlay {
    animation: intro-ride 1950ms cubic-bezier(0.42, 0, 0.22, 1) both;
  }

  .intro-curtain.is-floor-step .intro-floor-number {
    animation: intro-floor-step 280ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .intro-curtain.is-floor-step .intro-panel-floor {
    animation: intro-panel-floor-step 280ms ease-out both;
  }

  .intro-curtain.is-arriving .intro-floor-display {
    color: #fde68a;
    border-color: rgba(251, 191, 36, 0.72);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 8px 30px rgba(0, 0, 0, 0.56),
      0 0 26px rgba(245, 158, 11, 0.42);
  }

  .intro-curtain.is-arriving .intro-floor-arrow {
    animation: intro-arrival-blink 180ms ease-in-out 2;
  }

  .intro-curtain.is-arriving .intro-panel-arrow,
  .intro-curtain.is-arriving .intro-panel-floor {
    color: #fde68a;
    text-shadow: 0 0 10px #f59e0b;
  }

  .intro-curtain.is-arriving .intro-floor-button::before {
    opacity: 1;
    border-color: rgba(253, 230, 138, 0.86);
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.92);
    animation: intro-button-halo 900ms ease-out infinite;
  }

  .intro-curtain.is-arriving .intro-floor-button-core {
    color: #fff7d6;
    background: rgba(245, 158, 11, 0.34);
    border-color: #fde68a;
    box-shadow:
      inset 0 1px 2px rgba(255, 255, 255, 0.32),
      0 0 13px rgba(245, 158, 11, 0.96);
    animation: intro-button-glow 720ms ease-in-out infinite alternate;
  }

  .intro-curtain.is-arriving .intro-seam {
    opacity: 0.95;
    box-shadow: 0 0 24px 5px rgba(251, 191, 36, 0.55);
  }

  .intro-curtain.is-opening {
    pointer-events: none;
    background-color: transparent;
  }

  .intro-curtain.is-opening .intro-door--left {
    transform: translate3d(-100%, 0, 0);
  }

  .intro-curtain.is-opening .intro-door--right {
    transform: translate3d(100%, 0, 0);
  }

  .intro-curtain.is-opening .intro-hud {
    opacity: 0;
    transform: translate3d(0, 0, 0) scale(0.97);
  }

  .intro-curtain.is-opening .intro-shade {
    opacity: 0;
  }

  .intro-curtain.is-opening .intro-skip {
    opacity: 0;
    transform: translate3d(-50%, 0.4rem, 0);
  }

  .intro-curtain.is-opening .intro-seam {
    animation: intro-seam-release 720ms ease-out both;
  }

  @keyframes intro-ride {
    0% { transform: translate3d(0, 0, 0) scale(1.002); }
    20% { transform: translate3d(0, 1px, 0) scale(1.004); }
    44% { transform: translate3d(0, -2px, 0) scale(1.006); }
    68% { transform: translate3d(0, 1px, 0) scale(1.004); }
    100% { transform: translate3d(0, 0, 0) scale(1.002); }
  }

  @keyframes intro-arrival-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.28; }
  }

  @keyframes intro-floor-step {
    0% { opacity: 0.25; transform: translate3d(0, -0.3em, 0) scale(0.9); }
    60% { opacity: 1; transform: translate3d(0, 0.06em, 0) scale(1.08); }
    100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  }

  @keyframes intro-panel-floor-step {
    0% { opacity: 0.2; }
    55% { opacity: 1; text-shadow: 0 0 13px currentColor; }
    100% { opacity: 1; }
  }

  @keyframes intro-button-halo {
    0% { opacity: 0.9; transform: scale(0.82); }
    100% { opacity: 0; transform: scale(1.5); }
  }

  @keyframes intro-button-glow {
    0% { opacity: 0.78; transform: scale(0.96); }
    100% { opacity: 1; transform: scale(1.06); }
  }

  @keyframes intro-seam-release {
    0% {
      opacity: 0.95;
      transform: translate3d(-50%, 0, 0) scaleX(1);
    }
    42% {
      opacity: 1;
      transform: translate3d(-50%, 0, 0) scaleX(30);
      box-shadow: 0 0 44px 11px rgba(251, 191, 36, 0.64);
    }
    100% {
      opacity: 0;
      transform: translate3d(-50%, 0, 0) scaleX(72);
    }
  }

  @media (min-width: 640px) {
    .intro-skip-mobile {
      display: none;
    }

    .intro-skip-desktop {
      display: inline;
    }
  }

  @media (max-height: 520px) {
    .intro-hud {
      padding-top: max(0.65rem, env(safe-area-inset-top));
      padding-bottom: max(3.9rem, calc(env(safe-area-inset-bottom) + 3.25rem));
    }

    .intro-floor-display {
      padding-top: 0.45rem;
      padding-bottom: 0.45rem;
      padding-block: 0.45rem;
    }

    .intro-brand {
      transform: translateY(0);
    }

    .intro-logo {
      width: clamp(7.5rem, 27vmin, 13rem);
    }

    .intro-kicker {
      margin-top: 0.7rem;
    }

    .intro-skip {
      min-height: 2.35rem;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
      padding-block: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-door,
    .intro-door-image,
    .intro-panel-overlay,
    .intro-panel-arrow,
    .intro-panel-floor,
    .intro-floor-button,
    .intro-floor-button::before,
    .intro-floor-button-core,
    .intro-floor-button-label,
    .intro-hud,
    .intro-shade,
    .intro-skip,
    .intro-seam {
      animation: none !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const curtain = document.getElementById('intro-curtain');
    const skipButton = document.getElementById('intro-skip');
    const status = document.getElementById('intro-status');

    if (!curtain || !skipButton) return;

    const floorNumber = curtain.querySelector('.intro-floor-number');
    const floorArrow = curtain.querySelector('.intro-floor-arrow');
    const panelOverlay = curtain.querySelector('.intro-panel-overlay');
    const panelFloors = Array.from(curtain.querySelectorAll('.intro-panel-floor'));
    const panelArrows = Array.from(curtain.querySelectorAll('.intro-panel-arrow'));
    const images = Array.from(curtain.querySelectorAll('[data-intro-image]'));

    if (!floorNumber || !floorArrow || !panelOverlay) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(pointer: fine)');
    const landscapeViewport = window.matchMedia('(min-aspect-ratio: 1/1)');
    const timers = [];
    let animationFrame = 0;
    let viewportFrame = 0;
    let runId = 0;
    let hasOpened = false;
    let scrollLocked = false;
    let previousBodyOverflow = '';
    let previousHtmlOverflow = '';

    const later = (callback, delay) => {
      const timer = window.setTimeout(callback, delay);
      timers.push(timer);
      return timer;
    };

    const clearTimers = () => {
      while (timers.length) window.clearTimeout(timers.pop());
    };

    const stopTimeline = () => {
      if (!animationFrame) return;
      window.cancelAnimationFrame(animationFrame);
      animationFrame = 0;
    };

    const readViewport = () => {
      const visualViewport = window.visualViewport;
      const width = visualViewport && visualViewport.width
        ? visualViewport.width
        : (document.documentElement.clientWidth || window.innerWidth);
      const height = visualViewport && visualViewport.height
        ? visualViewport.height
        : (document.documentElement.clientHeight || window.innerHeight);

      return {
        width: Math.max(1, Math.round(width * 100) / 100),
        height: Math.max(1, Math.round(height * 100) / 100),
      };
    };

    const setPanelPixel = (name, value) => {
      panelOverlay.style.setProperty(name, `${Math.round(value * 100) / 100}px`);
    };

    const syncViewport = () => {
      const viewport = readViewport();
      curtain.style.setProperty('--intro-width', `${viewport.width}px`);
      curtain.style.setProperty('--intro-height', `${viewport.height}px`);

      const profile = landscapeViewport.matches
        ? {
            width: 688,
            height: 768,
            panelX: 196,
            arrowY: 169,
            floorY: 191,
            arrowSize: 12,
            floorSize: 20,
            buttonX: 196,
            buttonY: 358,
            buttonSize: 24,
            buttonFontSize: 13,
          }
        : {
            width: 309,
            height: 1374,
            panelX: 259.5,
            arrowY: 407,
            floorY: 432,
            arrowSize: 13,
            floorSize: 22,
            buttonX: 259.6,
            buttonY: 653.1,
            buttonSize: 27,
            buttonFontSize: 15,
          };

      const doorWidth = viewport.width / 2 + 1;
      const scale = Math.max(doorWidth / profile.width, viewport.height / profile.height);
      const offsetY = (viewport.height - profile.height * scale) / 2;

      setPanelPixel('--panel-x', profile.panelX * scale);
      setPanelPixel('--panel-arrow-y', profile.arrowY * scale + offsetY);
      setPanelPixel('--panel-floor-y', profile.floorY * scale + offsetY);
      setPanelPixel('--panel-arrow-size', Math.max(9, profile.arrowSize * scale));
      setPanelPixel('--panel-floor-size', Math.max(13, profile.floorSize * scale));
      setPanelPixel('--panel-button-x', profile.buttonX * scale);
      setPanelPixel('--panel-button-y', profile.buttonY * scale + offsetY);
      setPanelPixel('--panel-button-size', Math.max(16, profile.buttonSize * scale));
      setPanelPixel('--panel-button-font-size', Math.max(10, profile.buttonFontSize * scale));
      curtain.classList.add('is-panel-ready');
    };

    const requestViewportSync = () => {
      if (viewportFrame) window.cancelAnimationFrame(viewportFrame);
      viewportFrame = window.requestAnimationFrame(() => {
        viewportFrame = 0;
        syncViewport();
      });
    };

    const lockScroll = () => {
      if (scrollLocked) return;
      scrollLocked = true;
      previousBodyOverflow = document.body.style.overflow;
      previousHtmlOverflow = document.documentElement.style.overflow;
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
    };

    const restoreScroll = () => {
      if (!scrollLocked) return;
      document.body.style.overflow = previousBodyOverflow;
      document.documentElement.style.overflow = previousHtmlOverflow;
      scrollLocked = false;
    };

    const setDirectionIcon = (icon) => {
      floorArrow.textContent = icon;
      panelArrows.forEach((arrow) => {
        arrow.textContent = icon;
      });
    };

    const setFloor = (floor) => {
      const value = String(floor);
      floorNumber.textContent = value;
      panelFloors.forEach((panelFloor) => {
        panelFloor.textContent = value;
      });
      if (status) status.textContent = floor === 4
        ? 'Piso 4. Abriendo puertas de Sexto Vento.'
        : `Ascensor subiendo. Piso ${floor}.`;
    };

    const advanceToFloor = (floor) => {
      curtain.classList.remove('is-floor-step');
      setFloor(floor);
      void floorNumber.getBoundingClientRect();
      curtain.classList.add('is-floor-step');
      later(() => curtain.classList.remove('is-floor-step'), 300);
    };

    const finishOpening = (currentRun) => {
      if (currentRun !== runId) return;
      curtain.hidden = true;
      curtain.setAttribute('aria-hidden', 'true');
      curtain.classList.remove(
        'is-riding',
        'is-arriving',
        'is-opening',
        'is-floor-step',
      );
      restoreScroll();
    };

    const openDoors = () => {
      if (hasOpened) return;
      hasOpened = true;
      runId += 1;
      stopTimeline();
      clearTimers();
      setFloor(4);
      setDirectionIcon('◆');
      curtain.classList.remove('is-riding', 'is-floor-step');
      curtain.classList.add('is-arriving', 'is-opening');
      skipButton.disabled = true;

      const currentRun = runId;
      later(() => finishOpening(currentRun), reducedMotion.matches ? 100 : 1200);
    };

    const runSequence = (currentRun) => {
      if (currentRun !== runId || hasOpened) return;

      const reduced = reducedMotion.matches;
      const floor2At = reduced ? 400 : 650;
      const floor3At = reduced ? 800 : 1300;
      const floor4At = reduced ? 1200 : 1950;
      const openAt = reduced ? 1900 : 3000;
      let elapsed = 0;
      let lastTimestamp = 0;
      let stage = 1;

      if (!reduced) curtain.classList.add('is-riding');

      const tick = (timestamp) => {
        if (currentRun !== runId || hasOpened) return;

        if (document.visibilityState !== 'visible') {
          lastTimestamp = 0;
          animationFrame = window.requestAnimationFrame(tick);
          return;
        }

        if (lastTimestamp) {
          elapsed += Math.min(timestamp - lastTimestamp, 250);
        }
        lastTimestamp = timestamp;

        if (stage === 1 && elapsed >= floor2At) {
          stage = 2;
          advanceToFloor(2);
        }
        if (stage === 2 && elapsed >= floor3At) {
          stage = 3;
          advanceToFloor(3);
        }
        if (stage === 3 && elapsed >= floor4At) {
          stage = 4;
          advanceToFloor(4);
          setDirectionIcon('◆');
          curtain.classList.remove('is-riding');
          curtain.classList.add('is-arriving');
        }
        if (elapsed >= openAt) {
          openDoors();
          return;
        }

        animationFrame = window.requestAnimationFrame(tick);
      };

      animationFrame = window.requestAnimationFrame(tick);
    };

    const waitForVisibleImages = () => {
      const decodeTasks = images.map((image) => {
        if (image.complete && image.naturalWidth > 0) return Promise.resolve();
        if (typeof image.decode === 'function') {
          return image.decode().catch(() => undefined);
        }
        return new Promise((resolve) => {
          image.addEventListener('load', resolve, { once: true });
          image.addEventListener('error', resolve, { once: true });
        });
      });

      return Promise.race([
        Promise.all(decodeTasks),
        new Promise((resolve) => window.setTimeout(resolve, 1600)),
      ]);
    };

    const beginWhenVisible = (currentRun) => {
      const begin = async () => {
        if (currentRun !== runId || hasOpened) return;
        syncViewport();
        await waitForVisibleImages();
        if (currentRun !== runId || hasOpened) return;
        syncViewport();
        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => runSequence(currentRun));
        });
      };

      if (document.visibilityState === 'visible') {
        void begin();
        return;
      }

      const onVisible = () => {
        if (document.visibilityState !== 'visible') return;
        document.removeEventListener('visibilitychange', onVisible);
        void begin();
      };
      document.addEventListener('visibilitychange', onVisible);
    };

    const resetAndPlay = () => {
      runId += 1;
      stopTimeline();
      clearTimers();
      hasOpened = false;
      curtain.hidden = false;
      curtain.removeAttribute('aria-hidden');
      curtain.classList.remove(
        'is-riding',
        'is-arriving',
        'is-opening',
        'is-floor-step',
      );
      skipButton.disabled = false;
      setDirectionIcon('▲');
      setFloor(1);
      syncViewport();
      lockScroll();

      const currentRun = runId;
      beginWhenVisible(currentRun);
      later(() => {
        if (currentRun === runId && !hasOpened) openDoors();
      }, 8000);

      if (finePointer.matches) {
        window.requestAnimationFrame(() => skipButton.focus({ preventScroll: true }));
      }
    };

    skipButton.addEventListener('click', openDoors);
    curtain.addEventListener('touchmove', (event) => {
      event.preventDefault();
    }, { passive: false });
    document.addEventListener('keydown', (event) => {
      if (!curtain.hidden && event.key === 'Escape') openDoors();
    });
    window.addEventListener('resize', requestViewportSync, { passive: true });
    window.addEventListener('orientationchange', requestViewportSync, { passive: true });
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', requestViewportSync, { passive: true });
    }
    window.addEventListener('pagehide', () => {
      stopTimeline();
      restoreScroll();
    });
    window.addEventListener('pageshow', (event) => {
      syncViewport();
      if (event.persisted) resetAndPlay();
    });

    const handleReducedMotionChange = (event) => {
      if (event.matches && !curtain.hidden) resetAndPlay();
    };
    if (typeof reducedMotion.addEventListener === 'function') {
      reducedMotion.addEventListener('change', handleReducedMotionChange);
    } else if (typeof reducedMotion.addListener === 'function') {
      reducedMotion.addListener(handleReducedMotionChange);
    }

    resetAndPlay();
  })();
</script>
