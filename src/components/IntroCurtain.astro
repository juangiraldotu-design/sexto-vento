---
import Logo from './Logo.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div
  id="intro-curtain"
  role="dialog"
  aria-modal="true"
  aria-labelledby="intro-title"
  class="intro-curtain"
>
  <h2 id="intro-title" class="sr-only">Llegando a Sexto Vento, piso 4</h2>
  <p id="intro-status" class="sr-only" aria-live="polite">Ascensor subiendo al piso 4</p>

  <div class="intro-stage" aria-hidden="true">
    <div id="curtain-left" class="intro-door intro-door--left">
      <picture class="intro-picture">
        <source
          media="(min-aspect-ratio: 1/1)"
          srcset={`${baseUrl}/images/elevator-desktop-left.webp`}
        />
        <img
          class="intro-door-image"
          src={`${baseUrl}/images/elevator-door-left.webp`}
          width="309"
          height="1374"
          alt=""
          decoding="async"
          fetchpriority="high"
          draggable="false"
          data-intro-image
        />
      </picture>
    </div>

    <div id="curtain-right" class="intro-door intro-door--right">
      <picture class="intro-picture">
        <source
          media="(min-aspect-ratio: 1/1)"
          srcset={`${baseUrl}/images/elevator-desktop-right.webp`}
        />
        <img
          class="intro-door-image"
          src={`${baseUrl}/images/elevator-door-right.webp`}
          width="309"
          height="1374"
          alt=""
          decoding="async"
          fetchpriority="high"
          draggable="false"
          data-intro-image
        />
      </picture>
    </div>

    <div class="intro-shade"></div>
    <div id="intro-seam-light" class="intro-seam"></div>

    <div class="intro-hud">
      <div class="intro-floor-display">
        <span class="intro-floor-label">Piso</span>
        <span class="intro-floor-number">1</span>
        <span class="intro-floor-arrow" aria-hidden="true">▲</span>
      </div>

      <div class="intro-brand">
        <div class="intro-logo">
          <Logo class="w-full h-auto text-white" />
        </div>
        <p class="intro-kicker">Rooftop · Roldanillo</p>
      </div>
    </div>
  </div>

  <button id="intro-skip" class="intro-skip" type="button">
    <span class="intro-skip-mobile">Toca para entrar</span>
    <span class="intro-skip-desktop">Haz clic para entrar</span>
  </button>
</div>

<style>
  .intro-curtain {
    position: fixed;
    inset: 0;
    z-index: 9999;
    width: 100%;
    height: 100vh;
    height: 100svh;
    height: 100dvh;
    overflow: hidden;
    isolation: isolate;
    overscroll-behavior: none;
    touch-action: manipulation;
    background: #0b0c0d;
    opacity: 1;
    visibility: visible;
    contain: strict;
    transition: background-color 180ms ease-out, opacity 160ms ease-out 760ms,
      visibility 0s linear 940ms;
  }

  .intro-curtain[hidden] {
    display: none;
  }

  .intro-stage,
  .intro-door,
  .intro-picture,
  .intro-shade,
  .intro-hud {
    position: absolute;
    inset-block: 0;
  }

  .intro-stage,
  .intro-shade,
  .intro-hud {
    inset-inline: 0;
  }

  .intro-stage {
    overflow: hidden;
  }

  .intro-door {
    top: 0;
    bottom: 0;
    width: calc(50% + 1px);
    overflow: hidden;
    background: #17191b;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    will-change: transform;
    transition: transform 860ms cubic-bezier(0.76, 0, 0.24, 1);
  }

  .intro-door--left {
    left: 0;
    z-index: 1;
  }

  .intro-door--right {
    right: 0;
    z-index: 1;
  }

  .intro-picture {
    inset-inline: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .intro-door-image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    user-select: none;
    pointer-events: none;
    backface-visibility: hidden;
    transform: translate3d(0, 0, 0) scale(1.002);
    will-change: transform, filter;
    filter: saturate(0.78) contrast(1.08) brightness(0.8);
  }

  .intro-door--left .intro-door-image {
    object-position: right center;
  }

  .intro-door--right .intro-door-image {
    object-position: left center;
  }

  .intro-shade {
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% 46%, rgba(255, 255, 255, 0.03), transparent 34%),
      linear-gradient(180deg, rgba(3, 4, 5, 0.04), rgba(3, 4, 5, 0.18));
    opacity: 1;
    transition: opacity 240ms ease-out;
  }

  .intro-seam {
    position: absolute;
    inset-block: 0;
    left: 50%;
    z-index: 3;
    width: 1px;
    pointer-events: none;
    background: rgba(254, 243, 199, 0.88);
    box-shadow: 0 0 15px 3px rgba(245, 158, 11, 0.34);
    opacity: 0.55;
    transform: translate3d(-50%, 0, 0) scaleX(1);
    transform-origin: center;
    will-change: transform, opacity;
  }

  .intro-hud {
    z-index: 4;
    display: grid;
    grid-template-rows: auto 1fr;
    justify-items: center;
    padding:
      max(1rem, env(safe-area-inset-top))
      max(1rem, env(safe-area-inset-right))
      max(5rem, calc(env(safe-area-inset-bottom) + 4.25rem))
      max(1rem, env(safe-area-inset-left));
    pointer-events: none;
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    transition: opacity 220ms ease-out, transform 300ms ease-out;
  }

  .intro-floor-display {
    position: relative;
    display: inline-grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    column-gap: 0.45rem;
    min-width: 7.8rem;
    padding: 0.62rem 1.9rem 0.62rem 0.9rem;
    color: #86efac;
    background: linear-gradient(180deg, rgba(1, 8, 6, 0.96), rgba(2, 15, 10, 0.92));
    border: 1px solid rgba(226, 232, 240, 0.32);
    border-radius: 0.75rem;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 8px 30px rgba(0, 0, 0, 0.52),
      0 0 18px rgba(34, 197, 94, 0.14);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    text-transform: uppercase;
  }

  .intro-floor-label {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    opacity: 0.84;
  }

  .intro-floor-number {
    font-size: 1.65rem;
    line-height: 1;
    font-weight: 900;
    text-shadow: 0 0 12px currentColor;
    font-variant-numeric: tabular-nums;
  }

  .intro-floor-arrow {
    position: absolute;
    top: 50%;
    right: 0.75rem;
    font-size: 0.68rem;
    transform: translateY(-50%);
    filter: drop-shadow(0 0 5px currentColor);
  }

  .intro-brand {
    align-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(82vw, 28rem);
    transform: translateY(-2vh);
  }

  .intro-logo {
    width: clamp(9.5rem, 34vmin, 23rem);
    color: #fff;
    filter:
      drop-shadow(0 6px 24px rgba(0, 0, 0, 0.92))
      drop-shadow(0 0 24px rgba(255, 255, 255, 0.18));
  }

  .intro-kicker {
    margin: clamp(1rem, 2.8vmin, 1.6rem) 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: clamp(0.65rem, 1.4vmin, 0.78rem);
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.95);
  }

  .intro-skip {
    position: absolute;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 5;
    min-height: 2.75rem;
    padding: 0.72rem 1.15rem;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(10, 10, 11, 0.66);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 8px 24px rgba(0, 0, 0, 0.45);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    font: inherit;
    font-size: 0.69rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    opacity: 1;
    transform: translate3d(-50%, 0, 0);
    transition: opacity 180ms ease-out, transform 180ms ease-out, background-color 180ms ease-out;
  }

  .intro-skip:hover {
    background: rgba(26, 20, 16, 0.82);
  }

  .intro-skip:focus-visible {
    outline: 2px solid #fcd34d;
    outline-offset: 3px;
  }

  .intro-skip-desktop {
    display: none;
  }

  .intro-curtain.is-riding .intro-door-image {
    animation: intro-ride 660ms cubic-bezier(0.42, 0, 0.22, 1) both;
  }

  .intro-curtain.is-arriving .intro-floor-display {
    color: #fde68a;
    border-color: rgba(251, 191, 36, 0.72);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 8px 30px rgba(0, 0, 0, 0.56),
      0 0 26px rgba(245, 158, 11, 0.42);
  }

  .intro-curtain.is-arriving .intro-floor-arrow {
    animation: intro-arrival-blink 180ms ease-in-out 2;
  }

  .intro-curtain.is-arriving .intro-seam {
    opacity: 0.95;
    box-shadow: 0 0 24px 5px rgba(251, 191, 36, 0.55);
  }

  .intro-curtain.is-opening {
    pointer-events: none;
    background-color: transparent;
  }

  .intro-curtain.is-opening .intro-door--left {
    transform: translate3d(-100%, 0, 0);
  }

  .intro-curtain.is-opening .intro-door--right {
    transform: translate3d(100%, 0, 0);
  }

  .intro-curtain.is-opening .intro-hud {
    opacity: 0;
    transform: translate3d(0, 0, 0) scale(0.97);
  }

  .intro-curtain.is-opening .intro-shade {
    opacity: 0;
  }

  .intro-curtain.is-opening .intro-skip {
    opacity: 0;
    transform: translate3d(-50%, 0.4rem, 0);
  }

  .intro-curtain.is-opening .intro-seam {
    animation: intro-seam-release 720ms ease-out both;
  }

  @keyframes intro-ride {
    0% { transform: translate3d(0, 0, 0) scale(1.002); }
    20% { transform: translate3d(0, 1px, 0) scale(1.004); }
    44% { transform: translate3d(0, -2px, 0) scale(1.006); }
    68% { transform: translate3d(0, 1px, 0) scale(1.004); }
    100% { transform: translate3d(0, 0, 0) scale(1.002); }
  }

  @keyframes intro-arrival-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.28; }
  }

  @keyframes intro-seam-release {
    0% {
      opacity: 0.95;
      transform: translate3d(-50%, 0, 0) scaleX(1);
    }
    42% {
      opacity: 1;
      transform: translate3d(-50%, 0, 0) scaleX(30);
      box-shadow: 0 0 44px 11px rgba(251, 191, 36, 0.64);
    }
    100% {
      opacity: 0;
      transform: translate3d(-50%, 0, 0) scaleX(72);
    }
  }

  @media (min-width: 640px) {
    .intro-skip-mobile {
      display: none;
    }

    .intro-skip-desktop {
      display: inline;
    }
  }

  @media (max-height: 520px) {
    .intro-hud {
      padding-top: max(0.65rem, env(safe-area-inset-top));
      padding-bottom: max(3.9rem, calc(env(safe-area-inset-bottom) + 3.25rem));
    }

    .intro-floor-display {
      padding-block: 0.45rem;
    }

    .intro-brand {
      transform: translateY(0);
    }

    .intro-logo {
      width: clamp(7.5rem, 27vmin, 13rem);
    }

    .intro-kicker {
      margin-top: 0.7rem;
    }

    .intro-skip {
      min-height: 2.35rem;
      padding-block: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-door,
    .intro-door-image,
    .intro-hud,
    .intro-shade,
    .intro-skip,
    .intro-seam {
      animation: none !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const curtain = document.getElementById('intro-curtain');
    const skipButton = document.getElementById('intro-skip');
    const status = document.getElementById('intro-status');
    const floorNumber = curtain?.querySelector('.intro-floor-number');
    const floorArrow = curtain?.querySelector('.intro-floor-arrow');
    const images = Array.from(curtain?.querySelectorAll('[data-intro-image]') ?? []);

    if (!curtain || !skipButton || !floorNumber || !floorArrow) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const timers = [];
    let runId = 0;
    let hasOpened = false;
    let previousBodyOverflow = '';
    let previousHtmlOverflow = '';

    const later = (callback, delay) => {
      const timer = window.setTimeout(callback, delay);
      timers.push(timer);
      return timer;
    };

    const clearTimers = () => {
      while (timers.length) window.clearTimeout(timers.pop());
    };

    const lockScroll = () => {
      previousBodyOverflow = document.body.style.overflow;
      previousHtmlOverflow = document.documentElement.style.overflow;
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
    };

    const restoreScroll = () => {
      document.body.style.overflow = previousBodyOverflow;
      document.documentElement.style.overflow = previousHtmlOverflow;
    };

    const setFloor = (floor) => {
      floorNumber.textContent = String(floor);
      if (status) status.textContent = floor === 4
        ? 'Piso 4. Abriendo puertas de Sexto Vento.'
        : `Ascensor subiendo. Piso ${floor}.`;
    };

    const finishOpening = (currentRun) => {
      if (currentRun !== runId) return;
      curtain.hidden = true;
      curtain.setAttribute('aria-hidden', 'true');
      curtain.classList.remove('is-riding', 'is-arriving', 'is-opening');
    };

    const openDoors = () => {
      if (hasOpened) return;
      hasOpened = true;
      runId += 1;
      clearTimers();
      setFloor(4);
      floorArrow.textContent = '◆';
      curtain.classList.remove('is-riding');
      curtain.classList.add('is-arriving', 'is-opening');
      skipButton.disabled = true;
      restoreScroll();

      const currentRun = runId;
      later(() => finishOpening(currentRun), reducedMotion.matches ? 80 : 940);
    };

    const runSequence = (currentRun) => {
      if (currentRun !== runId || hasOpened) return;

      if (reducedMotion.matches) {
        setFloor(4);
        floorArrow.textContent = '◆';
        curtain.classList.add('is-arriving');
        later(openDoors, 320);
        return;
      }

      curtain.classList.add('is-riding');
      later(() => setFloor(2), 180);
      later(() => setFloor(3), 360);
      later(() => {
        setFloor(4);
        floorArrow.textContent = '◆';
        curtain.classList.remove('is-riding');
        curtain.classList.add('is-arriving');
      }, 560);
      later(openDoors, 820);
    };

    const waitForVisibleImages = () => {
      const decodeTasks = images.map((image) => {
        if (image.complete && image.naturalWidth > 0) return Promise.resolve();
        if (typeof image.decode === 'function') return image.decode().catch(() => undefined);
        return new Promise((resolve) => {
          image.addEventListener('load', resolve, { once: true });
          image.addEventListener('error', resolve, { once: true });
        });
      });

      return Promise.race([
        Promise.allSettled(decodeTasks),
        new Promise((resolve) => window.setTimeout(resolve, 550)),
      ]);
    };

    const beginWhenVisible = (currentRun) => {
      const begin = async () => {
        if (currentRun !== runId || hasOpened) return;
        await waitForVisibleImages();
        if (currentRun !== runId || hasOpened) return;
        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => runSequence(currentRun));
        });
      };

      if (document.visibilityState === 'visible') {
        void begin();
        return;
      }

      const onVisible = () => {
        if (document.visibilityState !== 'visible') return;
        document.removeEventListener('visibilitychange', onVisible);
        void begin();
      };
      document.addEventListener('visibilitychange', onVisible);
    };

    const resetAndPlay = () => {
      runId += 1;
      clearTimers();
      hasOpened = false;
      curtain.hidden = false;
      curtain.removeAttribute('aria-hidden');
      curtain.classList.remove('is-riding', 'is-arriving', 'is-opening');
      skipButton.disabled = false;
      floorArrow.textContent = '▲';
      setFloor(1);
      lockScroll();

      const currentRun = runId;
      beginWhenVisible(currentRun);
      window.requestAnimationFrame(() => skipButton.focus({ preventScroll: true }));
    };

    skipButton.addEventListener('click', openDoors);
    curtain.addEventListener('click', (event) => {
      if (event.target === skipButton || skipButton.contains(event.target)) return;
      openDoors();
    });
    document.addEventListener('keydown', (event) => {
      if (!curtain.hidden && event.key === 'Escape') openDoors();
    });
    window.addEventListener('pagehide', restoreScroll);
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) resetAndPlay();
    });
    reducedMotion.addEventListener?.('change', (event) => {
      if (event.matches && !curtain.hidden) openDoors();
    });

    resetAndPlay();
  })();
</script>
