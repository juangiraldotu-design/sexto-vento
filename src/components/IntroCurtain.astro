---
import Logo from './Logo.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- ════════ ULTRA-REALISTIC ELEVATOR ASCENT & SPLIT DOORS INTRO ════════ -->
<div 
  id="intro-curtain" 
  class="fixed inset-0 z-[100] pointer-events-auto overflow-hidden max-w-full select-none cursor-pointer"
  aria-hidden="true"
>
  <!-- ════════ LEFT ELEVATOR DOOR ════════ -->
  <div 
    id="curtain-left" 
    class="absolute top-0 left-0 w-1/2 h-full overflow-hidden border-r border-[#2C2E33] shadow-[3px_0_25px_rgba(0,0,0,0.95)]"
    style="transition: transform 1200ms cubic-bezier(0.22, 1, 0.36, 1), opacity 450ms ease-out 750ms;"
  >
    <!-- Background realistic grey elevator door texture -->
    <img 
      src={`${baseUrl}/images/user-door-left-extended.webp`} 
      alt="Puerta izquierda de ascensor metálico"
      class="absolute inset-0 w-full h-full object-cover object-right pointer-events-none brightness-[0.98]"
      loading="eager"
      decoding="async"
    />

    <!-- Vertical door seam bevel & dark rubber seal -->
    <div class="absolute inset-y-0 right-0 w-[2px] bg-gradient-to-b from-black via-[#18191B] to-black shadow-[0_0_6px_rgba(0,0,0,0.8)]"></div>

    <!-- 100vw container positioned at left: 0 so its center aligns with the seam -->
    <div class="absolute top-0 left-0 w-[100vw] h-full flex flex-col items-center justify-center pointer-events-none px-4">
      <div class="w-48 sm:w-64 md:w-80 lg:w-96 text-white filter drop-shadow-[0_4px_25px_rgba(0,0,0,0.95)] drop-shadow-[0_0_35px_rgba(255,255,255,0.25)]">
        <Logo class="w-full h-auto text-white" />
      </div>

      <!-- Subtle skip text -->
      <div class="mt-8 sm:mt-12 text-[10px] sm:text-xs font-semibold tracking-widest text-slate-300/80 uppercase drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
        Toca para abrir
      </div>
    </div>
  </div>

  <!-- ════════ RIGHT ELEVATOR DOOR ════════ -->
  <div 
    id="curtain-right" 
    class="absolute top-0 left-1/2 w-1/2 h-full overflow-hidden border-l border-[#2C2E33] shadow-[-3px_0_25px_rgba(0,0,0,0.95)]"
    style="transition: transform 1200ms cubic-bezier(0.22, 1, 0.36, 1), opacity 450ms ease-out 750ms;"
  >
    <!-- Background realistic grey elevator door texture -->
    <img 
      src={`${baseUrl}/images/user-door-right-extended.webp`} 
      alt="Puerta derecha de ascensor metálico"
      class="absolute inset-0 w-full h-full object-cover object-left pointer-events-none brightness-[0.98]"
      loading="eager"
      decoding="async"
    />

    <!-- Vertical door seam bevel & dark rubber seal -->
    <div class="absolute inset-y-0 left-0 w-[2px] bg-gradient-to-b from-black via-[#18191B] to-black shadow-[0_0_6px_rgba(0,0,0,0.8)]"></div>

    <!-- 100vw container offset by -50vw so its center aligns with the seam -->
    <div class="absolute top-0 -left-[50vw] w-[100vw] h-full flex flex-col items-center justify-center pointer-events-none px-4">
      <div class="w-48 sm:w-64 md:w-80 lg:w-96 text-white filter drop-shadow-[0_4px_25px_rgba(0,0,0,0.95)] drop-shadow-[0_0_35px_rgba(255,255,255,0.25)]">
        <Logo class="w-full h-auto text-white" />
      </div>

      <!-- Subtle skip text -->
      <div class="mt-8 sm:mt-12 text-[10px] sm:text-xs font-semibold tracking-widest text-slate-300/80 uppercase drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
        Toca para abrir
      </div>
    </div>

    <!-- ─── Retro Green LED Screen Overlay (Screen Area: Left 76.2%, Top 27.75%, Width 15.6%, Height 4.4%) ─── -->
    <div class="absolute left-[76.2%] top-[27.75%] w-[15.6%] h-[4.4%] flex flex-col items-center justify-center pointer-events-none select-none overflow-hidden">
      <div class="flex items-center justify-center gap-0.5 sm:gap-1 leading-none">
        <span 
          id="led-arrow" 
          class="font-mono text-[10px] sm:text-xs md:text-sm font-black text-emerald-400 drop-shadow-[0_0_6px_#34d399] animate-pulse"
        >
          ▲
        </span>
        <span 
          id="led-digit" 
          class="font-mono text-xs sm:text-sm md:text-base font-black text-emerald-400 tracking-tighter drop-shadow-[0_0_8px_#34d399]"
        >
          1
        </span>
      </div>
    </div>

    <!-- ─── Button 4 Glowing Active Ring Overlay (Center: Left 85.66%, Top 47.89%) ─── -->
    <div 
      id="btn-4-glow"
      class="absolute left-[85.66%] top-[47.89%] -translate-x-1/2 -translate-y-1/2 w-[7.8%] aspect-square rounded-full border border-emerald-400 shadow-[0_0_12px_#22c55e,inset_0_0_6px_#22c55e] animate-pulse pointer-events-none"
    >
    </div>

  </div>
</div>

<script is:inline>
  (() => {
    const curtain = document.getElementById('intro-curtain');
    const left = document.getElementById('curtain-left');
    const right = document.getElementById('curtain-right');
    const ledDigit = document.getElementById('led-digit');
    const ledArrow = document.getElementById('led-arrow');
    const btn4Glow = document.getElementById('btn-4-glow');

    if (!curtain || !left || !right) return;

    let hasOpened = false;

    function openDoors() {
      if (hasOpened) return;
      hasOpened = true;
      curtain.style.pointerEvents = 'none';

      // Split open the grey metallic elevator doors to left and right
      left.style.transform = 'translate3d(-100%, 0, 0)';
      left.style.opacity = '0';
      right.style.transform = 'translate3d(100%, 0, 0)';
      right.style.opacity = '0';

      // Clean up from DOM to ensure zero memory or scroll interference
      setTimeout(() => {
        curtain.remove();
      }, 1250);
    }

    // Sequence of floors: 1 -> 2 -> 3 -> 4
    setTimeout(() => {
      if (ledDigit) ledDigit.textContent = '2';
    }, 320);

    setTimeout(() => {
      if (ledDigit) ledDigit.textContent = '3';
    }, 650);

    setTimeout(() => {
      if (ledDigit) {
        ledDigit.textContent = '4';
        ledDigit.className = 'font-mono text-xs sm:text-sm md:text-base font-black text-amber-300 tracking-tighter drop-shadow-[0_0_12px_#f59e0b]';
      }
      if (ledArrow) {
        ledArrow.textContent = '★';
        ledArrow.className = 'font-mono text-[10px] sm:text-xs md:text-sm font-black text-amber-300 drop-shadow-[0_0_12px_#f59e0b]';
      }
      if (btn4Glow) {
        btn4Glow.className = 'absolute left-[85.66%] top-[47.89%] -translate-x-1/2 -translate-y-1/2 w-[7.8%] aspect-square rounded-full border-2 border-amber-300 shadow-[0_0_18px_#f59e0b,inset_0_0_8px_#f59e0b] pointer-events-none';
      }
    }, 980);

    // Automatic smooth door opening when floor 4 is reached
    setTimeout(openDoors, 1400);

    // Instant skip on tap, click, or scroll
    curtain.addEventListener('click', openDoors, { once: true });
    curtain.addEventListener('touchstart', openDoors, { once: true, passive: true });
    window.addEventListener('scroll', openDoors, { once: true, passive: true });
  })();
</script>
