---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-rooftop.jpg';
import { restaurantConfig } from '../config/restaurant.config';
---

<section id="video" class="max-w-xl md:max-w-3xl lg:max-w-5xl mx-auto px-4 sm:px-6 py-6 lg:py-10 reveal-on-scroll">
  <div class="liquid-card rounded-[32px] p-6 sm:p-8 lg:p-12 border border-white/12 relative overflow-hidden">
    <!-- Ambient Sunset Glow behind video card -->
    <div class="absolute -left-16 -top-16 w-56 h-56 lg:w-80 lg:h-80 rounded-full bg-amber-500/15 blur-[80px] pointer-events-none"></div>
    <div class="absolute -right-16 -bottom-16 w-60 h-60 lg:w-96 lg:h-96 rounded-full bg-orange-600/15 blur-[90px] pointer-events-none"></div>

    <div class="relative z-10 flex flex-col lg:grid lg:grid-cols-12 lg:gap-12 lg:items-center">
      
      <!-- Text Description Column -->
      <div class="lg:col-span-6 mb-8 lg:mb-0">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full liquid-pill text-xs sm:text-sm font-semibold text-amber-300 border border-amber-500/30 mb-3.5">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span>Experiencia Audiovisual</span>
        </div>

        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight mb-3 lg:mb-4">
          Conoce Sexto Vento en Video
        </h2>

        <p class="text-xs sm:text-sm lg:text-base text-slate-300/90 leading-relaxed mb-6">
          Un adelanto vertical de la atmósfera que te espera en el 4to piso: atardecer con vista panorámica a la cordillera, coctelería de autor y la mejor gastronomía de Roldanillo.
        </p>

        <!-- Feature highlights -->
        <div class="space-y-2.5 mb-6 text-xs sm:text-sm text-slate-300">
          <div class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-amber-500/20 text-amber-300 flex items-center justify-center font-bold text-xs border border-amber-500/30">✓</span>
            <span>Formato vertical optimizado para celular</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-amber-500/20 text-amber-300 flex items-center justify-center font-bold text-xs border border-amber-500/30">✓</span>
            <span>Tomas aéreas de la terraza y la plaza principal</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-amber-500/20 text-amber-300 flex items-center justify-center font-bold text-xs border border-amber-500/30">✓</span>
            <span>Presentación de platos insignia y cócteles</span>
          </div>
        </div>

        <!-- Social link pill -->
        <a 
          href={restaurantConfig.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-amber-300/80 hover:text-amber-200 transition-colors"
        >
          <span>Síguenos en Instagram para ver stories diarios</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

      <!-- Vertical 9:16 Video Player Container -->
      <div class="lg:col-span-6 flex justify-center">
        <div 
          id="video-player-card"
          class="w-full max-w-[280px] sm:max-w-[310px] aspect-[9/16] rounded-[32px] overflow-hidden relative border border-amber-500/30 shadow-[0_25px_60px_rgba(0,0,0,0.85)] group cursor-pointer select-none transform transition-transform duration-300 hover:scale-[1.02] active:scale-[0.98]"
        >
          <!-- Background Poster Image -->
          <Image 
            src={heroImage} 
            alt="Vista de la terraza de Sexto Vento" 
            class="absolute inset-0 w-full h-full object-cover brightness-[0.7] group-hover:brightness-[0.8] transition duration-500 scale-105 group-hover:scale-110"
            width={400}
            height={710}
            quality={75}
            format="webp"
            loading="eager"
            decoding="async"
          />

          <!-- Dark Gradient & Glass Vignette -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/35 to-black/60 pointer-events-none"></div>

          <!-- Top Overlay Badges -->
          <div class="absolute top-4 inset-x-4 flex items-center justify-between z-10 pointer-events-none">
            <span class="px-2.5 py-1 rounded-full text-[10px] sm:text-xs font-semibold bg-black/60 backdrop-blur-md text-slate-200 border border-white/15">
              4to Piso • Rooftop
            </span>
            <span class="px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold bg-amber-500/25 backdrop-blur-md text-amber-300 border border-amber-400/40 shadow-[0_0_12px_rgba(245,158,11,0.3)] flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
              Próximamente
            </span>
          </div>

          <!-- Centered Play Button & Halo -->
          <div class="absolute inset-0 flex flex-col items-center justify-center z-10">
            <div class="relative flex items-center justify-center">
              <!-- Ripple halo -->
              <div class="absolute w-20 h-20 sm:w-24 sm:h-24 rounded-full border border-amber-400/40 animate-ping opacity-30 pointer-events-none"></div>
              
              <!-- Frosted Play Button -->
              <button 
                type="button"
                id="play-button"
                aria-label="Reproducir video de presentación"
                class="w-16 h-16 sm:w-20 sm:h-20 rounded-full liquid-pill flex items-center justify-center text-amber-300 border border-amber-400/50 shadow-[0_10px_35px_rgba(245,158,11,0.4)] group-hover:scale-110 transition-transform duration-300 relative z-20"
              >
                <!-- Play triangle SVG -->
                <svg class="w-7 h-7 sm:w-8 sm:h-8 ml-1 fill-amber-300 filter drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </button>
            </div>
            
            <span class="mt-4 text-xs font-medium text-white/90 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] tracking-wide">
              Toca para reproducir
            </span>
          </div>

          <!-- Bottom Overlay: Title & Duration Badge -->
          <div class="absolute bottom-4 inset-x-4 z-10 pointer-events-none">
            <div class="liquid-card rounded-2xl p-3 border border-white/15 backdrop-blur-xl bg-black/60 shadow-lg">
              <div class="flex items-center justify-between gap-2">
                <div>
                  <h3 class="text-xs sm:text-sm font-bold text-white leading-tight">
                    Sexto Vento
                  </h3>
                  <p class="text-[10px] text-amber-300/90 font-medium">
                    Video Oficial de Presentación
                  </p>
                </div>
                <span class="px-2 py-0.5 rounded bg-white/10 text-[10px] font-semibold text-slate-300 border border-white/10">
                  0:45
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Modal: Video Próximamente -->
<div 
  id="video-modal" 
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div class="liquid-card rounded-[28px] max-w-sm w-full p-6 sm:p-7 border border-amber-500/30 relative text-center shadow-2xl bg-[#130B07]/95">
    <!-- Icon -->
    <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/40 text-2xl">
      🎬
    </div>

    <!-- Title -->
    <h3 id="modal-title" class="text-xl font-extrabold text-white mb-2">
      Video de Presentación
    </h3>

    <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-amber-500/25 text-amber-300 border border-amber-400/30 mb-4">
      En Producción Oficial
    </span>

    <!-- Message -->
    <p class="text-xs sm:text-sm text-slate-300/90 leading-relaxed mb-6">
      Estamos preparando la pieza audiovisual cinematográfica en formato vertical (Reel 4K) con los mejores momentos, cócteles y la panorámica del 4to piso.
      <br /><br />
      <span class="text-amber-200/90 font-semibold">¡Muy pronto podrás reproducirlo directamente en esta ventana!</span>
    </p>

    <!-- Buttons -->
    <div class="flex flex-col gap-2.5">
      <a 
        href={restaurantConfig.instagramUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full py-3 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 text-espresso font-bold text-xs sm:text-sm flex items-center justify-center gap-2 hover:opacity-95 transition-opacity"
      >
        <span>Ver Adelantos en Instagram</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>

      <button 
        type="button" 
        id="close-video-modal"
        class="w-full py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 font-semibold text-xs transition-colors border border-white/10"
      >
        Cerrar y Continuar
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const card = document.getElementById('video-player-card');
    const modal = document.getElementById('video-modal');
    const closeBtn = document.getElementById('close-video-modal');

    if (!card || !modal || !closeBtn) return;

    function openModal() {
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
    }

    function closeModal() {
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
    }

    card.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  })();
</script>
