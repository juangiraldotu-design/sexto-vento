---
import { restaurantConfig } from '../config/restaurant.config';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const videoBase = `${baseUrl}/video/sexto-vento`;
---

<section id="video" class="site-section">
  <div class="liquid-card section-panel relative overflow-hidden">
    <div class="relative z-10 flex flex-col lg:grid lg:grid-cols-12 lg:gap-12 lg:items-center">

      <!-- Text Description Column -->
      <div class="lg:col-span-6 mb-8 lg:mb-0">
        <div class="section-kicker rounded-full liquid-pill">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Video Oficial</span>
        </div>

        <h2 class="section-title mb-3 lg:mb-4">
          Conoce Sexto Vento en Video
        </h2>

        <p class="section-copy mb-6">
          Descubre la historia, la vista y la atmósfera que hacen de Sexto Vento un lugar especial en el corazón de Roldanillo.
        </p>

        <!-- Feature highlights -->
        <div class="space-y-3 mb-6 text-xs sm:text-sm text-slate-300">
          <div class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-amber-500/20 text-amber-300 flex items-center justify-center font-bold text-xs border border-amber-500/30">✓</span>
            <span>Calidad automática según tu conexión</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-amber-500/20 text-amber-300 flex items-center justify-center font-bold text-xs border border-amber-500/30">✓</span>
            <span>Reproducción optimizada para celular y computador</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-amber-500/20 text-amber-300 flex items-center justify-center font-bold text-xs border border-amber-500/30">✓</span>
            <span>Video vertical en alta definición con sonido estéreo</span>
          </div>
        </div>

        <!-- Social link pill -->
        <a
          href={restaurantConfig.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-amber-300/90 hover:text-amber-200 transition-colors"
        >
          <span>Síguenos en Instagram para ver historias y adelantos</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

      <!-- Vertical 9:16 Video Player Container -->
      <div class="lg:col-span-6 flex justify-center">
        <div
          id="video-player-card"
          class="video-player w-full max-w-[280px] sm:max-w-[310px] aspect-[9/16] rounded-[32px] overflow-hidden relative border border-amber-500/30 shadow-[0_25px_60px_rgba(0,0,0,0.85)] group select-none"
        >
          <video
            id="sexto-vento-video"
            class="absolute inset-0 h-full w-full object-cover bg-black"
            poster={`${videoBase}/poster.jpg`}
            preload="none"
            playsinline
            controls
            controlslist="nodownload"
            data-hls-src={`${videoBase}/master.m3u8`}
            data-fallback-src={`${videoBase}/fallback-540.mp4`}
            aria-label="Video oficial de Sexto Vento"
          ></video>

          <div class="video-player-shade absolute inset-0 pointer-events-none"></div>

          <!-- Top Overlay Badges -->
          <div class="absolute top-4 inset-x-4 flex items-center justify-between z-10 pointer-events-none">
            <span class="px-2.5 py-1 rounded-full text-[10px] sm:text-xs font-semibold bg-black/80 text-slate-200 border border-white/15">
              Piso 4 • Rooftop
            </span>
            <span class="px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold bg-[#1A0F09]/95 text-emerald-300 border border-emerald-400/30 shadow-[0_0_12px_rgba(52,211,153,0.2)] flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Calidad automática
            </span>
          </div>

          <button
            id="video-start-overlay"
            type="button"
            class="video-start-overlay absolute inset-0 z-10 flex flex-col items-center justify-center text-white"
            aria-label="Reproducir video oficial de Sexto Vento"
          >
            <div class="relative flex items-center justify-center">
              <span class="video-play-halo absolute w-20 h-20 sm:w-24 sm:h-24 rounded-full border border-amber-300/45 pointer-events-none"></span>

              <span class="video-play-button w-16 h-16 sm:w-20 sm:h-20 rounded-full liquid-pill flex items-center justify-center text-amber-200 border border-amber-300/55 shadow-[0_10px_35px_rgba(245,158,11,0.4)] transition-transform duration-300 relative z-20">
                <svg class="w-7 h-7 sm:w-8 sm:h-8 ml-1 fill-amber-300 filter drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </span>
            </div>

            <span id="video-player-status" class="mt-4 text-xs font-semibold text-white/95 drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)] tracking-wide">
              Reproducir video
            </span>
          </button>

          <!-- Bottom Overlay: Title & Duration Badge -->
          <div class="absolute bottom-4 inset-x-4 z-10 pointer-events-none">
            <div class="liquid-card rounded-2xl p-3 border border-amber-400/25 bg-[#140C07]/95 shadow-lg">
              <div class="flex items-center justify-between gap-2">
                <div>
                  <h3 class="text-xs sm:text-sm font-bold text-white leading-tight">
                    Sexto Vento
                  </h3>
                  <p class="text-[10px] text-amber-300/90 font-medium">
                    Una historia desde Roldanillo
                  </p>
                </div>
                <span class="px-2 py-0.5 rounded bg-white/10 text-[10px] font-semibold text-slate-300 border border-white/10">
                  0:51
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .video-player {
    background: #070504;
    transform: translate3d(0, 0, 0);
  }

  .video-player-shade {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.18), transparent 35%, rgba(0, 0, 0, 0.72));
    opacity: 1;
    transition: opacity 280ms ease;
  }

  .video-start-overlay {
    border: 0;
    background: transparent;
    cursor: pointer;
    transition: opacity 240ms ease, visibility 0s linear 240ms;
  }

  .video-start-overlay:hover .video-play-button,
  .video-start-overlay:focus-visible .video-play-button {
    transform: scale(1.08);
  }

  .video-start-overlay:focus-visible {
    outline: 2px solid #fde68a;
    outline-offset: -4px;
  }

  .video-play-halo {
    animation: video-halo 1.8s ease-out infinite;
  }

  .video-player.has-started .video-start-overlay,
  .video-player.has-started > div {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .video-player.is-loading .video-play-button {
    animation: video-loading 900ms linear infinite;
  }

  @keyframes video-halo {
    0% { opacity: 0.5; transform: scale(0.82); }
    100% { opacity: 0; transform: scale(1.38); }
  }

  @keyframes video-loading {
    0% { transform: scale(0.92); opacity: 0.6; }
    50% { transform: scale(1); opacity: 1; }
    100% { transform: scale(0.92); opacity: 0.6; }
  }

  @media (prefers-reduced-motion: reduce) {
    .video-play-halo,
    .video-player.is-loading .video-play-button {
      animation: none;
    }
  }
</style>

<script>
  const card = document.getElementById('video-player-card');
  const video = document.getElementById('sexto-vento-video');
  const startButton = document.getElementById('video-start-overlay');
  const status = document.getElementById('video-player-status');

  if (card instanceof HTMLElement && video instanceof HTMLVideoElement && startButton instanceof HTMLButtonElement) {
    const hlsSource = video.dataset.hlsSrc || '';
    const fallbackSource = video.dataset.fallbackSrc || '';
    let hls: any = null;
    let prepared = false;
    let preparing: Promise<void> | null = null;
    let wantsToPlay = false;

    const setStatus = (message: string) => {
      if (status) status.textContent = message;
    };

    const useFallback = () => {
      hls?.destroy();
      hls = null;
      if (fallbackSource && video.getAttribute('src') !== fallbackSource) {
        video.src = fallbackSource;
        video.load();
      }
    };

    const preparePlayer = async () => {
      if (preparing) return preparing;
      if (prepared) return;
      prepared = true;

      if (hlsSource && video.canPlayType('application/vnd.apple.mpegurl')) {
        video.src = hlsSource;
        video.load();
        return;
      }

      preparing = import('hls.js/dist/hls.light.min.mjs')
        .then(({ default: Hls }) => {
          if (!hlsSource || !Hls.isSupported()) {
            useFallback();
            return;
          }
          hls = new Hls({
            startLevel: -1,
            capLevelToPlayerSize: true,
            maxBufferLength: 20,
            maxMaxBufferLength: 40,
            backBufferLength: 12,
          });
          hls.loadSource(hlsSource);
          hls.attachMedia(video);
          hls.on(Hls.Events.ERROR, (_event: string, data: { fatal?: boolean }) => {
            if (!data.fatal) return;
            useFallback();
            if (wantsToPlay) void video.play().catch(() => setStatus('Toca para reproducir'));
          });
        })
        .catch(() => useFallback())
        .finally(() => {
          preparing = null;
        });

      return preparing;
    };

    const playVideo = async () => {
      wantsToPlay = true;
      card.classList.add('is-loading');
      setStatus('Preparando video…');
      await preparePlayer();
      void video.play().catch(() => {
        card.classList.remove('is-loading');
        setStatus('Toca para reproducir');
      });
    };

    startButton.addEventListener('click', () => void playVideo());
    video.addEventListener('playing', () => {
      wantsToPlay = false;
      card.classList.remove('is-loading');
      card.classList.add('is-playing', 'has-started');
    });
    video.addEventListener('pause', () => {
      card.classList.remove('is-playing', 'is-loading');
      if (!video.ended && video.currentTime > 0) setStatus('Continuar video');
    });
    video.addEventListener('waiting', () => {
      if (!video.paused) card.classList.add('is-loading');
    });
    video.addEventListener('canplay', () => {
      card.classList.remove('is-loading');
      if (wantsToPlay) void video.play();
    });
    video.addEventListener('ended', () => {
      card.classList.remove('is-playing', 'is-loading');
    });
    video.addEventListener('error', () => {
      card.classList.remove('is-playing', 'is-loading');
      setStatus('No se pudo cargar. Reintentar');
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        void preparePlayer();
        observer.disconnect();
      }, { rootMargin: '500px 0px' });
      observer.observe(card);
    } else {
      void preparePlayer();
    }

  }
</script>
