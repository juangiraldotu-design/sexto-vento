---
interface Props {
  class?: string;
  fill?: string;
}

const { class: className = 'w-auto h-16 text-white', fill = 'currentColor' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<span
  class:list={[className, 'brand-logo']}
  style={`--brand-logo-url: url("${baseUrl}/favicon.svg"); color: ${fill};`}
  role="img"
  aria-label="Gastrobar Sexto Vento"
></span>

<style>
  .brand-logo {
    display: block;
    width: 100%;
    aspect-ratio: 622 / 452;
    background-color: currentColor;
    -webkit-mask: var(--brand-logo-url) center / contain no-repeat;
    mask: var(--brand-logo-url) center / contain no-repeat;
  }

  @supports not (aspect-ratio: 1 / 1) {
    .brand-logo {
      height: 0 !important;
      padding-top: 72.6688%;
    }
  }
</style>
