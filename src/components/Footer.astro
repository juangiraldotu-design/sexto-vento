---
import Logo from './Logo.astro';
import { restaurantConfig } from '../config/restaurant.config';
---

<footer class="max-w-xl md:max-w-3xl lg:max-w-5xl mx-auto px-4 sm:px-6 pt-4 lg:pt-8 pb-36 sm:pb-40 text-center">
  <div class="liquid-card rounded-[28px] p-7 lg:p-10 border border-amber-400/20">
    
    <!-- Vector Logo Centerpiece -->
    <div class="w-40 sm:w-48 mx-auto mb-4 opacity-90 hover:opacity-100 transition-opacity">
      <Logo class="w-full h-auto text-white" />
    </div>

    <h3 class="text-sm font-bold text-white mb-1 tracking-tight">
      {restaurantConfig.name}
    </h3>
    <p class="text-xs text-amber-200/70 max-w-xs mx-auto mb-6">
      {restaurantConfig.rooftopNote} • {restaurantConfig.city}
    </p>

    <!-- Social & External Links in Apple Liquid Pills -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-6">
      <a 
        href={restaurantConfig.instagramUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="liquid-pill px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-200 hover:text-white inline-flex items-center gap-1.5 btn-press"
      >
        <span>Instagram</span>
        <span class="text-slate-400 text-[11px]">↗</span>
      </a>
      <a 
        href={restaurantConfig.menuUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="liquid-pill px-3.5 py-1.5 rounded-full text-xs font-semibold text-slate-200 hover:text-white inline-flex items-center gap-1.5 btn-press"
      >
        <span>Menú Unglo</span>
        <span class="text-slate-400 text-[11px]">↗</span>
      </a>
      <a 
        href={restaurantConfig.whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="liquid-pill px-3.5 py-1.5 rounded-full text-xs font-semibold text-emerald-400 hover:text-emerald-300 inline-flex items-center gap-1.5 btn-press"
      >
        <span>WhatsApp</span>
        <span class="text-emerald-500 text-[11px]">↗</span>
      </a>
    </div>

    <div class="pt-5 border-t border-amber-500/15 text-[11px] text-white/40">
      <p>© {new Date().getFullYear()} {restaurantConfig.name}. Todos los derechos reservados.</p>
      <p class="mt-1">Roldanillo, Valle del Cauca, Colombia.</p>
    </div>
  </div>
</footer>
