---
import Logo from './Logo.astro';
import { restaurantConfig } from '../config/restaurant.config';
---

<footer class="mx-auto w-full max-w-6xl px-4 pb-36 pt-8 text-center sm:px-6 sm:pb-40 lg:pt-16">
  <div class="editorial-section border-y border-amber-400/25 p-7 lg:p-12">
    
    <!-- Vector Logo Centerpiece -->
    <div class="mx-auto mb-5 w-52 opacity-95 transition-opacity hover:opacity-100 sm:w-64">
      <Logo class="w-full h-auto text-white" />
    </div>

    <h3 class="mb-1 text-lg font-black tracking-[-0.035em] text-white">
      {restaurantConfig.name}
    </h3>
    <p class="text-xs text-amber-200/70 max-w-xs mx-auto mb-6">
      {restaurantConfig.rooftopNote} • {restaurantConfig.city}
    </p>

    <!-- Social & External Links in Apple Liquid Pills -->
    <div class="mb-7 flex flex-wrap items-center justify-center gap-px overflow-hidden border border-amber-100/20 bg-amber-100/20">
      <a 
        href={restaurantConfig.instagramUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 bg-[#110a06] px-4 py-2 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-200 transition-colors hover:bg-amber-50 hover:text-black btn-press"
      >
        <span>Instagram</span>
        <span class="text-slate-400 text-[11px]">↗</span>
      </a>
      <a 
        href={restaurantConfig.menuUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 bg-[#110a06] px-4 py-2 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-200 transition-colors hover:bg-amber-50 hover:text-black btn-press"
      >
        <span>Menú Unglo</span>
        <span class="text-slate-400 text-[11px]">↗</span>
      </a>
      <a 
        href={restaurantConfig.whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 bg-[#110a06] px-4 py-2 text-[10px] font-bold uppercase tracking-[0.12em] text-emerald-400 transition-colors hover:bg-amber-50 hover:text-black btn-press"
      >
        <span>WhatsApp</span>
        <span class="text-emerald-500 text-[11px]">↗</span>
      </a>
    </div>

    <div class="pt-5 border-t border-amber-500/15 text-[11px] text-white/40">
      <p>© {new Date().getFullYear()} {restaurantConfig.name}. Todos los derechos reservados.</p>
      <p class="mt-1">Roldanillo, Valle del Cauca, Colombia.</p>
    </div>
  </div>
</footer>
