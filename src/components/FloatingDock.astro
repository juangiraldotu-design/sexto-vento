---
import { restaurantConfig } from '../config/restaurant.config';
---

<aside 
  class="fixed bottom-0 inset-x-0 z-50 px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-2 sm:p-4 pointer-events-none transition-all duration-300 transform translate-y-[120%] opacity-0 max-w-full"
  id="floating-dock"
>
  <div class="max-w-md md:max-w-lg lg:max-w-xl mx-auto pointer-events-auto">
    <div class="p-1.5 sm:p-2.5 rounded-full border border-amber-400/25 shadow-[0_16px_40px_rgba(0,0,0,0.9)] flex items-center justify-between gap-2 md:gap-3 bg-[#140C07]/95">
      
      <!-- Primary Action: Apple Signature White Pill CTA -->
      <a 
        href={restaurantConfig.menuUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="apple-cta-primary flex-1 inline-flex items-center justify-between pl-3.5 sm:pl-5 md:pl-6 pr-1 md:pr-2 py-1.5 md:py-2 text-xs md:text-sm font-bold btn-press shadow-md group min-w-0"
      >
        <span class="tracking-tight truncate">Ver Menú Digital</span>
        <span class="w-6 h-6 sm:w-7 sm:h-7 md:w-8 md:h-8 rounded-full bg-black text-white flex items-center justify-center text-[11px] font-bold group-hover:rotate-45 transition-transform duration-200 shrink-0 ml-2">
          ↗
        </span>
      </a>

      <!-- Secondary Action: Apple Liquid Glass WhatsApp CTA -->
      <a 
        href={restaurantConfig.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Reservar mesa por WhatsApp"
        class="apple-cta-glass inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 md:px-5 py-1.5 sm:py-2 md:py-2.5 text-xs md:text-sm font-semibold btn-press shrink-0"
      >
        <span class="w-2 h-2 md:w-2.5 md:h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Reservar</span>
      </a>

    </div>
  </div>
</aside>
